<UserControl x:Class="AuroraDesignSuite.Views.MissileEngineLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1250">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Mode Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🧪 CENTRO DE CREACIÓN Y DISEÑO DE PROYECTOS I+D" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Generador paramétrico de proyectos de investigación emparejado en vivo con las tecnologías investigadas en AuroraDB.db." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="BtnModeDesigner" Content="➕ Diseñador de Nuevos Proyectos" IsChecked="True" Checked="OnModeChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Margin="0,0,6,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" ToolTip="Herramientas avanzadas de diseño para crear sensores, armas, misiles, torretas, motores y formaciones."/>
                    <RadioButton x:Name="BtnModeCatalog" Content="📚 Catálogo de Proyectos (Juego + App)" Checked="OnModeChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Visualizador unificado de todos los proyectos creados en el juego Aurora 4X y guardados en la app."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace with Resizable Grid Splitters -->
        <Grid Grid.Row="1">
            <!-- MODE 1: MULTI-CATEGORY PROJECT DESIGNER -->
            <Grid x:Name="PnlProjectDesigner" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" MinWidth="320"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Master Category Dropdown & Dynamic Researched Tech Options -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,2,0">
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="🛠️ SELECCIONAR CATEGORÍA DE PROYECTO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="Categorías oficiales de componentes de Aurora 4X:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,0,0,6"/>

                            <!-- MASTER CATEGORY DROPDOWN (Matches Screenshot #2 of Aurora 4X) -->
                            <ComboBox x:Name="CmbMasterCategory" SelectionChanged="CmbMasterCategory_SelectionChanged" Margin="0,0,0,12" Padding="8,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" ToolTip="Selecciona la categoría del componente a diseñar. Carga automáticamente las tecnologías investigadas de tu imperio desde AuroraDB.db.">
                                <ComboBoxItem Content="📡 Active Sensors" IsSelected="True"/>
                                <ComboBoxItem Content="🛡️ CIWS"/>
                                <ComboBoxItem Content="👻 Cloaking Device"/>
                                <ComboBoxItem Content="🛰️ Decoy Launcher"/>
                                <ComboBoxItem Content="🎯 Direct Fire Control"/>
                                <ComboBoxItem Content="⚡ EM Detection Sensors"/>
                                <ComboBoxItem Content="⚙️ Engines"/>
                                <ComboBoxItem Content="✈️ Fighter Pod Bay"/>
                                <ComboBoxItem Content="🔫 Gauss Cannon"/>
                                <ComboBoxItem Content="📡 High Power Microwave"/>
                                <ComboBoxItem Content="🌀 Jump Engines"/>
                                <ComboBoxItem Content="💥 Lasers"/>
                                <ComboBoxItem Content="📦 Magazine"/>
                                <ComboBoxItem Content="🔮 Meson Cannon"/>
                                <ComboBoxItem Content="🛠️ Miscellaneous Components"/>
                                <ComboBoxItem Content="🎯 Missile Fire Control"/>
                                <ComboBoxItem Content="🚀 Missile Launchers"/>
                                <ComboBoxItem Content="⚡ Particle Beam"/>
                                <ComboBoxItem Content="🔥 Plasma Carronade"/>
                                <ComboBoxItem Content="⚡ Power Plants"/>
                                <ComboBoxItem Content="🚅 Railgun"/>
                                <ComboBoxItem Content="🛡️ Shield Generators"/>
                                <ComboBoxItem Content="🔥 Thermal Sensors"/>
                            </ComboBox>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

                            <!-- COMPANY NAME SELECTION (Aurora 4X Feature) -->
                            <TextBlock Text="🏢 Empresa Constructora / Fabricante (Company Name):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbCompanyName" SelectionChanged="CmbCompanyName_SelectionChanged" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" ToolTip="Empresas y fabricantes de defensa registrados en AuroraDB.db."/>
                                <Button Grid.Column="1" Content="🏢 Prefijar Empresa" Click="BtnApplyCompany_Click" Padding="8,4" Margin="6,0,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" ToolTip="Agrega el nombre de la empresa como prefijo en el proyecto."/>
                            </Grid>

                            <!-- Component Name Input -->
                            <TextBlock Text="Nombre del Proyecto / Componente:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtProjectName" Text="Commercial Active Sensor AS8-R100" Margin="0,0,0,12" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="Nombre descriptivo único con el que se registrará el proyecto en la base de datos de Aurora 4X."/>

                            <!-- DYNAMIC RESEARCHED TECH SUB-DROPDOWNS (Matches Screenshot #3 of Aurora 4X) -->
                            <StackPanel x:Name="PnlSubTechControls">
                                <!-- Sub Tech 1 -->
                                <TextBlock x:Name="LblSubTech1" Text="Tecnología Base Investigada:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbSubTech1" SelectionChanged="OnParamChanged" Margin="0,0,0,10" Padding="6,4"/>

                                <!-- Sub Tech 2 -->
                                <TextBlock x:Name="LblSubTech2" Text="Eficiencia / Consumo de Combustible:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbSubTech2" SelectionChanged="OnParamChanged" Margin="0,0,0,10" Padding="6,4"/>

                                <!-- Sub Tech 3 -->
                                <TextBlock x:Name="LblSubTech3" Text="Reducción de Firma Térmica / Blindaje:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbSubTech3" SelectionChanged="OnParamChanged" Margin="0,0,0,10" Padding="6,4"/>

                                <!-- Sub Tech 4 -->
                                <TextBlock x:Name="LblSubTech4" Text="Montaje Específico / Tipo de Cañón:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2" Visibility="Collapsed"/>
                                <ComboBox x:Name="CmbSubTech4" SelectionChanged="OnParamChanged" Margin="0,0,0,10" Padding="6,4" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- PARAMETER SLIDERS -->
                            <StackPanel x:Name="PnlParam1Container" Visibility="Visible">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="LblParam1Title" Text="Tamaño del Componente (HS / Tons):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblValParam1" Text="1.0 HS (50 t)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldParam1" Minimum="0.1" Maximum="100" Value="1.0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnParamChanged" Margin="0,0,0,10" ToolTip="Volumen total ocupado por el componente en cascos (1 HS = 50 Tons)."/>
                            </StackPanel>

                            <StackPanel x:Name="PnlParam2Container" Visibility="Visible">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="LblParam2Title" Text="Modificador de Potencia / Resolución:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblValParam2" Text="Res 100 (5,000t)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldParam2" Minimum="1" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnParamChanged" Margin="0,0,0,12" ToolTip="Multiplicador de potencia operativa o resolución de radar de destino."/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⭐ Guardar Preset App" Click="BtnSaveAppPreset_Click" Padding="6,8" Margin="0,0,4,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" FontWeight="Bold" ToolTip="Guarda esta configuración como una plantilla del usuario en la aplicación."/>
                                <Button Grid.Column="1" Content="🚀 Crear en DB" Click="BtnCreateProjectInDB_Click" Padding="6,8" Margin="4,0,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Registra este proyecto de investigación e instala el componente directamente en AuroraDB.db."/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- VERTICAL GRID SPLITTER (Resizable left/right) -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Cursor="SizeWE" ToolTip="Arrastra hacia la izquierda o derecha para cambiar el tamaño de los paneles."/>

                <!-- Right Column: Live Specifications, Telemetry, Advice Cards & Simulator -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="2,0,0,0">
                    <StackPanel>
                        <!-- Card 1: Performance Specifications -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📊 ESPECIFICACIONES TÉCNICAS Y RENDIMIENTO I+D" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                                
                                <UniformGrid Columns="3">
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Masa total del componente en Puntos de Casco (HS) y Toneladasmétricas (1 HS = 50 Tons).">
                                        <StackPanel>
                                            <TextBlock Text="Masa Total Componente:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecSize" Text="1.0 HS (50 Tons)" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Costo en Puntos de Investigación (RP) para desarrollar este prototipo en los Laboratorios de I+D del imperio.">
                                        <StackPanel>
                                            <TextBlock Text="Costo Investigación (RP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecCostRP" Text="100 RP" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Costo en Puntos de Construcción Industrial (BP) para fabricar una unidad física de este componente en fábrica o astillero.">
                                        <StackPanel>
                                            <TextBlock Text="Costo Fabricación (BP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecCostBP" Text="2.0 BP" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Personal militar o técnico necesario para operar y mantener este módulo a bordo de la nave.">
                                        <StackPanel>
                                            <TextBlock Text="Tripulación Necesaria:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecCrew" Text="2 Personas" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Hits To Kill (HTK): Número de impactos directos que puede absorber antes de quedar inhabilitado por daño interno.">
                                        <StackPanel>
                                            <TextBlock Text="Resistencia HTK:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecHTK" Text="1 Hit To Kill" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Indicador principal de rendimiento táctico (EP de empuje, Alcance en Mkm o Daño focal).">
                                        <StackPanel>
                                            <TextBlock Text="Rendimiento / Alcance:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecPerformance" Text="8.28 Mkm" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 DESCRIPCIÓN TÁCTICA DEL DISEÑO:" Foreground="{DynamicResource AccentAmberBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="LblSpecDescription" Text="Active Sensor Strength 2 | Sensitivity Modifier: 50% | Resolution 100 | Maximum Range vs 5000 ton object: 8.28 Mkm" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Minerals & Material Requirements -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="💎 REQUERIMIENTO DE MINERALES EXÓTICOS IMPERIALES" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                                
                                <ItemsControl x:Name="IcProjectMinerals">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding Value, StringFormat={}{0:N1} Tons}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Imperial R&D Engineering Advisor & Doctrinal Guidance -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🎓 ASESOR DE INGENIERÍA IMPERIAL Y CONSEJOS TÁCTICOS" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Tiempo estimado en meses terrestres para completar la investigación del proyecto con 1 laboratoria activo.">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Tiempo Est. I+D (1 Lab):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblEstResearchTime" Text="1.2 Meses" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Firma electromagnética o infrarroja emitida por este componente durante la operación.">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Firma Emitida / Visibilidad:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblThermalSignatureAdvice" Text="Firma Normal (100%)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="📜 RECOMENDACIÓN DOCTRINAL DE INGENIERÍA:" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="LblAdvisorGuidance" Text="💡 Diseña componentes equilibrando la masa en HS. Los motores más grandes ofrecen mayor eficiencia de combustible por EP, mientras que las ojivas más grandes provocan cráteres penetrantes profundos en el blindaje enemigo." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Tactical Simulator Matrix -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel x:Name="PnlSimulatorMatrix">
                                <TextBlock Text="🚀 MATRIZ DE SIMULACIÓN OPERATIVA EN VIVO" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock Text="Rendimiento simulado según el tamaño del casco o distancia de combate:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,0,0,8"/>

                                <UniformGrid Columns="4">
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="LblSimCol1Title" Text="Casco 1,000 t" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblSimCol1Value" Text="2,500 km/s" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="LblSimCol2Title" Text="Casco 5,000 t" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblSimCol2Value" Text="1,000 km/s" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="LblSimCol3Title" Text="Casco 10,000 t" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblSimCol3Value" Text="500 km/s" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="LblSimCol4Title" Text="Casco 25,000 t" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblSimCol4Value" Text="200 km/s" Foreground="{DynamicResource AccentRedBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Aurora 4X Physics Formulas & Math Rules -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="📐 FÓRMULAS FÍSICAS Y REGLAS MATEMÁTICAS DE AURORA 4X" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock x:Name="LblPhysicsFormulas" Text="• Potencia Motor (EP) = Masa (HS) × 50 × Modificador Potencia&#10;• Consumo Combustible = EP × Litros/EP/Hora&#10;• Alcance Radar = Fuerza × Masa (HS) × √(Resolución) × 40,000 km&#10;• Penetración de Daño = √(Daño Ojiva) en capas de blindaje" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- MODE 2: UNIFIED PROJECTS CATALOG (GAME + APP) -->
            <Grid x:Name="PnlProjectCatalog" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Bar -->
                <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filtrar por Origen del Proyecto:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbCatalogSourceFilter" SelectionChanged="CmbCatalogSourceFilter_SelectionChanged" Width="240" Padding="6,4">
                                <ComboBoxItem Content="🌐 Todos los Proyectos (Juego + App)" IsSelected="True"/>
                                <ComboBoxItem Content="🎮 Solo Creados en el Juego (Aurora 4X)"/>
                                <ComboBoxItem Content="💻 Solo Creados en la App"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock x:Name="LblCatalogTotalCount" Grid.Column="1" Text="Proyectos Cargados: 0" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Catalog DataGrid -->
                <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <DataGrid x:Name="DgProjectCatalog" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Origen" Binding="{Binding SourceBadge}" Width="150"/>
                            <DataGridTextColumn Header="Nombre del Proyecto / Componente" Binding="{Binding Name}" Width="280"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="180"/>
                            <DataGridTextColumn Header="Costo I+D" Binding="{Binding CostDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Tamaño (HS/Masa)" Binding="{Binding SizeDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Especificaciones Tácticas / Descripción" Binding="{Binding SpecificationsSummary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
