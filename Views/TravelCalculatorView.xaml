                            <TextBlock Text="🚀 16. Logística de Catapulta de Masa &amp; Seguridad (Mass Driver Transport Safety)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula las toneladas de mineral transferidas anualmente entre asteroides. Compara catapultas emisoras vs receptoras para PREVENIR COLISIONES DE IMPACTO DEVASTADOR en el planeta destino." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Catapultas Emisoras:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaMassDriverSender" Text="3" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
