<UserControl x:Class="AuroraDesignSuite.Views.FleetCompositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1250">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="350"/>
        </Grid.ColumnDefinitions>

        <!-- GridSplitter for Resizing Fleet Workbench and Items Table -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True" ToolTip="Arrastra horizontalmente para redimensionar el agregador de flota y la tabla de naves">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource BorderBrush}" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Column 0: Fleet Aggregator, Fuel & Mineral Workbench -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
            <StackPanel>
                <!-- Guidance Banner: Purpose of Naval Audit -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🛡️ AUDITORÍA NAVAL Y PREPARACIÓN DOCTRINAL (FCT_Fleet &amp; FCT_Ship)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                        <TextBlock Text="Módulo táctico para auditar la factibilidad operacional y doctrinal de tus escuadras imperiales:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="• Combina planos del Diseñador, clases guardadas en tu imperio y flotas operativas reales de AuroraDB.db.&#10;• Calcula los requerimientos totales de combustible de campaña y Sorium refinado.&#10;• Agrega la demanda completa de minerales exóticos necesarios para construir la flota.&#10;• Evalúa la factibilidad de construcción en tus astilleros e importa tus flotas reales en vivo." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Fleet Add & Formations Section -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚓ AGREGADOR DE FLOTA Y ASTILLERO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Text="Blueprint Actual del Diseñador:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,2"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtActiveDesignName" Text="Golondrina de Guerra MK-I" IsReadOnly="True" VerticalAlignment="Center" ToolTip="Planos de la nave actualmente cargada desde el Diseñador."/>
                            <Button Grid.Column="1" Content="➕ Añadir" Click="BtnAddCurrentShip_Click" Padding="10,4" Margin="4,0,0,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" ToolTip="Añade la nave del Diseñador a la composición."/>
                        </Grid>

                        <TextBlock Text="Añadir Clase Guardada del Imperio:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,2"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbEmpireClasses" VerticalAlignment="Center" ToolTip="Lista de clases de naves registradas en tu imperio."/>
                            <Button Grid.Column="1" Content="➕ Añadir" Click="BtnAddSelectedClass_Click" Padding="10,4" Margin="4,0,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Añade la clase seleccionada a la composición."/>
                        </Grid>

                        <TextBlock Text="Cargar Formación Predefinida:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,2"/>
                        <ComboBox x:Name="CmbPresetFormations" SelectionChanged="CmbPresetFormations_SelectionChanged" ToolTip="Escuadras y flotas tácticas pre-configuradas para pruebas inmediatas."/>

                        <Button Content="🌌 Importar Flotas Operativas Reales" Click="BtnImportActiveFleets_Click" Padding="10,6" Margin="0,8,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" FontWeight="Bold" ToolTip="Importa automáticamente las flotas operativas activas de tu partida guardada de Aurora 4X."/>
                    </StackPanel>
                </Border>

                <!-- Campaign Fuel Calculator -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎯 CALCULADOR DE COMBUSTIBLE DE CAMPAÑA" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Distancia Misión (Billones km):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox x:Name="TxtCampaignDist" Text="50,0" TextChanged="OnFleetInputChanged" ToolTip="Distancia total de ida y vuelta que recorrerá la flota."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Equivalente UA:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblCampaignAU" Text="334.2 AU" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,2" ToolTip="Combustible total necesario en Litros para mover la flota entera la distancia fijada.">
                                    <TextBlock Text="Combustible Req. Campaña:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblCampaignFuelNeeded" Text="0 Litros" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2" ToolTip="Capacidad máxima combinada de los tanques de combustible de la flota.">
                                    <TextBlock Text="Capacidad Tanques Flota:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblFleetFuel" Text="0 Litros" Foreground="White" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2" ToolTip="Toneladas del mineral exótico Sorium que tus refinerías deben procesar para fabricar el combustible (1 t Sorium = 2,500 L).">
                                    <TextBlock Text="Sorium Refinado Req.:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblCampaignSoriumNeeded" Text="0.0 t Sorium" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Fleet Totals & Minerals -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="💎 SUMA TOTAL DE MINERALES PARA CONSTRUIR LA FLOTA" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="IcFleetMinerals" ToolTip="Suma acumulada de todas las toneladas de minerales requeridas por los astilleros para fabricar la flota entera.">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Value, StringFormat={}{0:N1} t}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Column 2: Fleet Items DataGrid, Tactical Telemetry & Shipyard Feasibility -->
        <Grid Grid.Column="2" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Fleet Items Table -->
            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="🛸 CLASES Y UNIDADES EN LA FLOTA" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <Button Content="✕ Eliminar Clase" Click="BtnRemoveFleetItem_Click" HorizontalAlignment="Right" Padding="8,2" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentRedBrush}" BorderBrush="{DynamicResource AccentRedBrush}" ToolTip="Quita la clase de nave seleccionada de la flota."/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="DgFleetItems" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="DgFleetItems_CellEditEnding" ToolTip="Lista de clases de naves incluidas en esta flota. Puedes editar la cantidad directamente.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Clase de Nave" Binding="{Binding Design.ClassName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Count}" Width="55"/>
                            <DataGridTextColumn Header="Velocidad" Binding="{Binding Design.MaxSpeedKmS, StringFormat={}{0:N0} km/s}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Masa Unidad" Binding="{Binding Design.TotalTonnage, StringFormat={}{0:N0} t}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Masa Total" Binding="{Binding TotalTonnage, StringFormat={}{0:N0} t}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Costo BP" Binding="{Binding TotalCostBP, StringFormat={}{0:N1}}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Combustible" Binding="{Binding TotalFuelLiters, StringFormat={}{0:N0} L}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Tripulación" Binding="{Binding TotalCrew, StringFormat={}{0:N0}}" IsReadOnly="True" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary Bar -->
                    <Border Grid.Row="2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" ToolTip="Suma del tonelaje total de todas las naves de la flota.">
                                <TextBlock Text="Masa Total Flota:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblFleetTonnage" Text="0 Tons" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" ToolTip="Costo total en Puntos de Construcción (BP) para fabricar la flota entera.">
                                <TextBlock Text="Costo BP Total:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblFleetCost" Text="0 BP" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" ToolTip="Puntos de suministro de mantenimiento (MSP) acumulados en la flota.">
                                <TextBlock Text="Reserva MSP Flota:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblFleetMSP" Text="0 MSP" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" ToolTip="Total de oficiales y marineros requeridos para tripular la flota entera.">
                                <TextBlock Text="Tripulación Total:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblFleetCrew" Text="0 Personas" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Fleet Tactical Telemetry Dashboard -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="📊 TELEMETRÍA TÁCTICA Y DESPLIEGUE EN FORMACIÓN" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" ToolTip="Velocidad real de navegación de la flota entera (determinada por la velocidad de la nave más lenta).">
                            <TextBlock Text="Velocidad Formación:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblFleetSpeed" Text="0 km/s" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" ToolTip="Alcance operativo máximo antes de que la nave con menor autonomía agote sus tanques.">
                            <TextBlock Text="Alcance Formación:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblFleetRange" Text="0 Billones km" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" ToolTip="Firma térmica emitida por los motores de la flota combinada.">
                            <TextBlock Text="Firma Térmica Total:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblFleetThermal" Text="0 W" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" ToolTip="Firma electromagnética emitida por escudos y sensores activos combinados.">
                            <TextBlock Text="Firma EM Total:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblFleetEM" Text="0 W" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Shipyard Feasibility Matrix -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="🏭 FACTIBILIDAD Y ASIGNACIÓN EN ASTILLEROS IMPERIALES" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>

                    <Grid x:Name="PnlShipyardFeasibility">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblShipyardFeasibilityStatus" Text="🟢 Todos los astilleros imperiales cuentan con capacidad de tonelaje suficiente para fabricar esta flota." Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🚀 Enviar Ordenes de Fabricación a Astilleros" Click="BtnSendToShipyards_Click" Padding="10,4" Margin="8,0,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Registra la fabricación de esta flota en tus astilleros."/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
