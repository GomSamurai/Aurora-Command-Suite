<Window x:Class="AuroraDesignSuite.Views.CustomThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Estudio de Diseño y Editor de Temas Personalizados" 
        Height="780" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Title Banner -->
        <Border Grid.Row="0" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎨 ESTUDIO Y EDITOR DE TEMAS PERSONALIZADOS" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="✨ Edición Táctica con Previsualización en Vivo en Toda la App" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Base Template & Theme Name Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cargar Plantilla Base de Arranque:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbBaseTemplate" SelectionChanged="CmbBaseTemplate_SelectionChanged" ToolTip="Selecciona un tema existente como punto de partida para tu diseño personalizado."/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Nombre de tu Tema Personalizado:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCustomThemeName" Text="💾 Mi Tema Personalizado Imperial" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentAmberBrush}" ToolTip="Escribe el nombre con el que deseas guardar tu tema."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Color Roles Editor List (Scrollable) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel x:Name="PnlColorRoles">
                <!-- Guidance Box -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <TextBlock Text="💡 NOTA TÁCTICA: Al modificar cualquier color o código #HEX, toda la suite se actualizará EN VIVO en tiempo real en segundo plano. Los nombres indican la FUNCIÓN exacta del elemento en la interfaz." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                </Border>

                <ItemsControl x:Name="IcColorRoles">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category & Icon Badge -->
                                    <Border Grid.Column="0" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryBadge}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                    </Border>

                                    <!-- Role Description & Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoleTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding RoleDescription}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Live Color Swatch Box -->
                                    <Border Grid.Column="2" Width="44" Height="26" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="{Binding SwatchBrush}" Margin="12,0,10,0" VerticalAlignment="Center" ToolTip="Muestra de color en tiempo real."/>

                                    <!-- Hex Input Box -->
                                    <TextBox Grid.Column="3" Text="{Binding HexValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="85" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" FontWeight="Bold" HorizontalContentAlignment="Center" ToolTip="Código de color Hexadecimal (#RRGGBB)."/>

                                    <!-- Color Dialog Button -->
                                    <Button Grid.Column="4" Content="🎨 Cambiar" Click="BtnPickColor_Click" Padding="10,4" VerticalAlignment="Center" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10.5" ToolTip="Abre la paleta de colores para seleccionar cualquier tono."/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="📥 Importar (.json)" Click="BtnImportTheme_Click" Padding="10,6" Margin="0,0,6,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" ToolTip="Carga un archivo de tema de color (.json) desde tu disco."/>
                    <Button Content="📤 Exportar (.json)" Click="BtnExportTheme_Click" Padding="10,6" Margin="0,0,6,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" ToolTip="Guarda tu configuración de color en un archivo .json para compartir o respaldar."/>
                    <Button x:Name="BtnDeleteTheme" Content="🗑️ Eliminar Tema" Click="BtnDeleteTheme_Click" Padding="10,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentRedBrush}" BorderBrush="{DynamicResource AccentRedBrush}" ToolTip="Elimina este tema de tus temas personalizados guardados."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 Restaurar Plantilla Base" Click="BtnReset_Click" Padding="10,6" Margin="0,0,8,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="Revierte los cambios y restaura los colores de la plantilla base."/>
                    <Button Content="💾 GUARDAR TEMA PERSONALIZADO" Click="BtnSaveTheme_Click" Padding="14,6" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Guarda el tema personalizado en tus preferencias e impleméntalo de inmediato."/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
