<UserControl x:Class="AuroraDesignSuite.Views.MissileEngineLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1250">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Mode Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🧪 CENTRO DE CREACIÓN Y DISEÑO DE PROYECTOS I+D" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Modelado paramétrico en tiempo real emparejado en vivo con AuroraDB.db y catálogo de proyectos del imperio." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="BtnModeDesigner" Content="➕ Diseñador de Nuevos Proyectos" IsChecked="True" Checked="OnModeChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Margin="0,0,6,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" ToolTip="Herramientas avanzadas de diseño para crear sensores, armas, misiles, torretas, motores y formaciones."/>
                    <RadioButton x:Name="BtnModeCatalog" Content="📚 Catálogo de Proyectos (Juego + App)" Checked="OnModeChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Visualizador unificado de todos los proyectos creados en el juego Aurora 4X y guardados en la app."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <!-- MODE 1: MULTI-CATEGORY PROJECT DESIGNER -->
            <Grid x:Name="PnlProjectDesigner" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Category Navigation & Dynamic Controls -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,5,0">
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="🛠️ SELECCIONAR CATEGORÍA DE PROYECTO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            
                            <!-- Creation Categories Grid -->
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <RadioButton x:Name="RbCatSensors" Content="📡 Sensores" IsChecked="True" Checked="OnCategoryChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,6" Margin="2" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" ToolTip="Diseño de sensores activos comerciales/militares, térmicos y electromagnéticos pasivos."/>
                                <RadioButton x:Name="RbCatWeapons" Content="💥 Armas Energía" Checked="OnCategoryChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,6" Margin="2" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" FontWeight="Bold" ToolTip="Láseres, mesones, cañones Gauss, railguns y carronadas de plasma."/>
                                <RadioButton x:Name="RbCatMissiles" Content="🚀 Misiles" Checked="OnCategoryChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,6" Margin="2" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Misiles antibuque (ASM), antimisil (AMM), torpedos y señuelos navales."/>
                                <RadioButton x:Name="RbCatTurrets" Content="🛡️ Torretas" Checked="OnCategoryChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,6" Margin="2" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" ToolTip="Montajes de torretas simples, dobles o cuádruples con velocidad de seguimiento."/>
                                <RadioButton x:Name="RbCatEngines" Content="⚡ Motores" Checked="OnCategoryChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,6" Margin="2" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" FontWeight="Bold" ToolTip="Propulsores militares, comerciales, para cazas y blindaje térmico."/>
                                <RadioButton x:Name="RbCatGround" Content="⚔️ Terrestre" Checked="OnCategoryChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="8,6" Margin="2" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Formaciones de infantería, tanques de asalto y piezas de artillería."/>
                            </UniformGrid>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

                            <!-- Common Project Name Input -->
                            <TextBlock Text="Nombre del Proyecto / Componente:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtProjectName" Text="Active Sensor Buscar AS8-R100" Margin="0,0,0,12" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="Nombre descriptivo único con el que se registrará el proyecto en el árbol de investigación."/>

                            <!-- Dynamic Parameters Box (Sensors / Engines / Missiles / Weapons) -->
                            <StackPanel x:Name="PnlSensorControls" Visibility="Visible">
                                <TextBlock Text="Tipo de Sensor:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbSensorType" SelectionChanged="OnParamChanged" Margin="0,0,0,10">
                                    <ComboBoxItem Content="📡 Active Search Sensor (Militar)" IsSelected="True"/>
                                    <ComboBoxItem Content="📦 Commercial Active Sensor (Comercial)"/>
                                    <ComboBoxItem Content="🔥 Thermal Passive Sensor (Térmico)"/>
                                    <ComboBoxItem Content="⚡ EM Passive Sensor (Electromagnético)"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tamaño del Sensor (HS / Tons):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblValSensorSize" Text="1.0 HS (50 t)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldSensorSize" Minimum="0.1" Maximum="20" Value="1.0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnParamChanged" Margin="0,0,0,10" ToolTip="Tamaño en cascos (1 HS = 50 Tons). Sensores más grandes ofrecen mayor alcance de detección."/>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Resolución de Destino (Res):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblValSensorRes" Text="Res 100 (5,000t)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldSensorRes" Minimum="1" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnParamChanged" Margin="0,0,0,10" ToolTip="Resolución del radar. Res 1 para cazas/misiles, Res 20 para corbetas, Res 100 para cruceros."/>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Contra-contramedidas (ECCM):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblValSensorEccm" Text="ECCM-0" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SldSensorEccm" Minimum="0" Maximum="5" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnParamChanged" Margin="0,0,0,12" ToolTip="Nivel de protección contra jamming e interferencias electrónicas enemigas."/>
                            </StackPanel>

                            <!-- Generic Parameters Sliders -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Multiplicador de Rendimiento:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblValPowerMod" Text="1.00x" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SldPowerMod" Minimum="0.5" Maximum="3.0" Value="1.0" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="OnParamChanged" Margin="0,0,0,12" ToolTip="Aumenta el rendimiento y la efectividad operativa a cambio de mayor consumo de recursos."/>

                            <!-- Action Buttons -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⭐ Guardar Preset App" Click="BtnSaveAppPreset_Click" Padding="6,8" Margin="0,0,4,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" FontWeight="Bold" ToolTip="Guarda esta configuración como una plantilla del usuario en la aplicación."/>
                                <Button Grid.Column="1" Content="🚀 Crear en DB" Click="BtnCreateProjectInDB_Click" Padding="6,8" Margin="4,0,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Registra este proyecto de investigación e instala el componente directamente en AuroraDB.db."/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Right Column: Live Specifications & Mineral Breakdown -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="5,0,0,0">
                    <StackPanel>
                        <!-- Card 1: Performance Specifications -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📊 ESPECIFICACIONES TÉCNICAS Y RENDIMIENTO I+D" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                                
                                <UniformGrid Columns="3">
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Masa Total Componente:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecSize" Text="1.0 HS (50 Tons)" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Costo Investigación (RP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecCostRP" Text="100 RP" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Costo Fabricación (BP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecCostBP" Text="2.0 BP" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Tripulación Necesaria:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecCrew" Text="2 Personas" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Resistencia HTK:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecHTK" Text="1 Hit To Kill" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Rango Máximo Detección:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock x:Name="LblSpecPerformance" Text="8,281,161 km" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 DESCRIPCIÓN TÁCTICA DEL DISEÑO:" Foreground="{DynamicResource AccentAmberBrush}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="LblSpecDescription" Text="Active Sensor Strength 2 | Sensitivity Modifier: 50% | Resolution 100 | Maximum Range vs 5000 ton object: 8,281,161 km | Range vs 1000 ton object: 331,246 km" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Minerals & Material Requirements -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="💎 REQUERIMIENTO DE MINERALES EXÓTICOS" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                                
                                <ItemsControl x:Name="IcProjectMinerals">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding Value, StringFormat={}{0:N1} Tons}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- MODE 2: UNIFIED PROJECTS CATALOG (GAME + APP) -->
            <Grid x:Name="PnlProjectCatalog" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Bar -->
                <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filtrar por Origen del Proyecto:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbCatalogSourceFilter" SelectionChanged="CmbCatalogSourceFilter_SelectionChanged" Width="220" Padding="6,4">
                                <ComboBoxItem Content="🌐 Todos los Proyectos (Juego + App)" IsSelected="True"/>
                                <ComboBoxItem Content="🎮 Solo Creados en el Juego (Aurora 4X)"/>
                                <ComboBoxItem Content="💻 Solo Creados en la App"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock x:Name="LblCatalogTotalCount" Grid.Column="1" Text="Proyectos Cargados: 0" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Catalog DataGrid -->
                <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <DataGrid x:Name="DgProjectCatalog" AutoGenerateColumns="False" IsReadOnly="True" ToolTip="Proyectos de investigación y componentes personalizados registrados en AuroraDB.db y guardados en la app.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Origen" Binding="{Binding SourceBadge}" Width="150"/>
                            <DataGridTextColumn Header="Nombre del Proyecto / Componente" Binding="{Binding Name}" Width="280"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="180"/>
                            <DataGridTextColumn Header="Costo I+D" Binding="{Binding CostDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Tamaño (HS/Masa)" Binding="{Binding SizeDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Especificaciones Tácticas / Descripción" Binding="{Binding SpecificationsSummary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
