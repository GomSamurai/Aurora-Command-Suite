<UserControl x:Class="AuroraDesignSuite.Views.SystemExplorationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1250">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Mode Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <DockPanel DockPanel.Dock="Top">
                <TextBlock Text="🌌 SUITE DE EXPLORACIÓN E INTELIGENCIA INTERESTELAR" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="5,0,20,0"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton x:Name="BtnModeProspection" Content="🌌 Prospección y Cuerpos Celestes" IsChecked="True" Checked="OnModeChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="14,6" Margin="0,0,6,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" ToolTip="Exploración geológica y física de planetas, lunas y yacimientos minerales."/>
                    <RadioButton x:Name="BtnModeJumpPoints" Content="🌀 Red de Puntos de Salto" Checked="OnModeChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="14,6" Margin="0,0,6,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" FontWeight="Bold" ToolTip="Red de nodos de salto interestelar y estado de construcción de Puertas de Salto (Jump Gates)."/>
                    <RadioButton x:Name="BtnModeSurveyFleets" Content="🛸 Flotas de Prospección Activas" Checked="OnModeChanged" Style="{StaticResource {x:Type ToggleButton}}" Padding="14,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Buques y escuadras de reconocimiento geológico y gravitatorio en servicio."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Mode Container -->
        <Grid Grid.Row="1">
            <!-- MODE 1: PROSPECTION & SYSTEM BODIES -->
            <Grid x:Name="PnlProspection" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="260"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="350"/>
                </Grid.ColumnDefinitions>

                <!-- GridSplitter for Resizing Systems Panel and Celestial Bodies Panel -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True" ToolTip="Arrastra horizontalmente para redimensionar los sistemas estelares y los cuerpos celestes">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="{DynamicResource BorderBrush}" Width="2" HorizontalAlignment="Center"/>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- Left Column: Discovered Star Systems & System Info -->
                <Grid Grid.Column="0" Margin="0,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="🌌 SISTEMAS ESTELARES DESCUBIERTOS" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            <DataGrid x:Name="DgSystems" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgSystems_SelectionChanged" ToolTip="Sistemas solares mapeados por tus naves exploradoras.">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sistema Estelar" Binding="{Binding SystemName}" Width="*"/>
                                    <DataGridTextColumn Header="Estrellas" Binding="{Binding StarCount}" Width="65"/>
                                    <DataGridTextColumn Header="Abundancia" Binding="{Binding AbundanceModifier, StringFormat={}{0:F2}}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- System Summary Card -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel x:Name="PnlSysSummary">
                            <TextBlock Text="📊 RESUMEN DE PROSPECCIÓN DEL SISTEMA" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <TextBlock Text="Cuerpos Detectados:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblSysBodiesCount" Text="0 Cuerpos" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Puntos de Salto Conocidos:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblSysJumpCount" Text="0 Puntos" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right Column: Planets, Minerals, Colonization Viability & Actions -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="4,0,0,0">
                    <StackPanel>
                        <!-- Card 1: Celestial Bodies Grid with Search Bar -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="LblBodiesHeader" Text="🪐 PLANETAS, LUNAS Y CUERPOS CELESTES EN SISTEMA" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="🔍 Buscar Cuerpo:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtSearchBody" TextChanged="TxtSearchBody_TextChanged" Width="180" Padding="4" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="11" ToolTip="Busca rápidamente cualquier planeta, luna o asteroide descubierto por su nombre (ej. 'Earth', 'Mars', 'Sol', 'Luna')."/>
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid x:Name="DgBodies" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240" SelectionChanged="DgBodies_SelectionChanged" ToolTip="Cuerpos celestes analizados en este sistema estelar con telemetría astrofísica completa.">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nombre del Cuerpo" Binding="{Binding Name}" Width="130"/>
                                        <DataGridTextColumn Header="Clase" Binding="{Binding BodyTypeName}" Width="130"/>
                                        <DataGridTextColumn Header="Gravedad" Binding="{Binding GravityDisplay}" Width="80"/>
                                        <DataGridTextColumn Header="Temperatura" Binding="{Binding TempDisplay}" Width="90"/>
                                        <DataGridTextColumn Header="Atmósfera" Binding="{Binding AtmosDisplay}" Width="80"/>
                                        <DataGridTextColumn Header="Costo Colonial" Binding="{Binding ColonyCostDisplay}" Width="150"/>
                                        <DataGridTextColumn Header="Radio (km)" Binding="{Binding RadiusDisplay}" Width="90"/>
                                        <DataGridTextColumn Header="Masa (M⊕)" Binding="{Binding MassDisplay}" Width="85"/>
                                        <DataGridTextColumn Header="Dist. Órbita" Binding="{Binding OrbitalDistDisplay}" Width="95"/>
                                        <DataGridTextColumn Header="Año Planetario" Binding="{Binding YearDisplay}" Width="120"/>
                                        <DataGridTextColumn Header="Día (Duración)" Binding="{Binding DayDisplay}" Width="105"/>
                                        <DataGridTextColumn Header="Hidrosfera" Binding="{Binding HydroDisplay}" Width="100"/>
                                        <DataGridTextColumn Header="Magnetosfera" Binding="{Binding MagneticFieldDisplay}" Width="120"/>
                                        <DataGridTextColumn Header="Ruinas" Binding="{Binding RuinsDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="Fábricas" Binding="{Binding FactoriesDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="Prospección" Binding="{Binding SurveyStatusDisplay}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Mineral Deposits Grid -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="LblMineralsHeader" Text="💎 YACIMIENTOS MINERALES EN CUERPO CELESTE" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <DataGrid x:Name="DgMinerals" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180" ToolTip="Depósitos de minerales exóticos trans-uranianos detectados en este planeta.">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mineral Exótico" Binding="{Binding MineralName}" Width="*"/>
                                        <DataGridTextColumn Header="Reservas Estimadas" Binding="{Binding AmountDisplay}" Width="180"/>
                                        <DataGridTextColumn Header="Accesibilidad de Minería" Binding="{Binding AccessibilityDisplay}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Comprehensive Physical, Environmental & Archaeological Telemetry -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🔬 TELEMETRÍA ASTRO-FÍSICA, CLIMÁTICA Y BIOCLIMÁTICA EN VIVO" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 1: Physical & Orbital -->
                                    <Border Grid.Column="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Propiedades de masa, radio y mecánica orbital del planeta o luna.">
                                        <StackPanel>
                                            <TextBlock Text="📐 ASTRO-FÍSICA Y ÓRBITA" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                            <Grid Margin="0,1"><TextBlock Text="Radio:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValRadius" Text="6,378 km" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Densidad:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValDensity" Text="1.00 g/cm³" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Masa Planetaria:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValMass" Text="1.00 M⊕" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Distancia Órbita:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValOrbDist" Text="1.00 UA" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Periodo Orbital (Año):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValYear" Text="1.0 Años" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Duración del Día:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValDay" Text="24.0 h" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Velocidad Escape:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValEscape" Text="11.2 km/s" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Acoplamiento Marea:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValTidal" Text="🔄 Libre" Foreground="{DynamicResource AccentCyanBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Column 2: Atmosphere & Climate -->
                                    <Border Grid.Column="1" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Condiciones de presión atmosférica, cobertura de océanos y magnetosfera.">
                                        <StackPanel>
                                            <TextBlock Text="🌐 CLIMA Y ATMÓSFERA" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                            <Grid Margin="0,1"><TextBlock Text="Presión Atmosférica:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValAtmos" Text="1.01 atm" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Temp. Superficie:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValTemp" Text="13.6 °C" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Temp. Absoluta (K):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValTempK" Text="286.8 K" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Hidrosfera / Océanos:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValHydro" Text="69.7% Océanos" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Albedo Planetario:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValAlbedo" Text="1.02" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Efecto Invernadero:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValGHFactor" Text="1.10" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Magnetosfera:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValMagnet" Text="🛡️ Fuerte (1.0)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Column 3: Environment & Archaeology -->
                                    <Border Grid.Column="2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Presencia de ruinas antiguas alienígenas, instalaciones abandonadas y radiación.">
                                        <StackPanel>
                                            <TextBlock Text="🏛️ RECURSOS Y RUINAS" Foreground="{DynamicResource AccentPurpleBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                            <Grid Margin="0,1"><TextBlock Text="Ruinas Alienígenas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValRuins" Text="Sin Ruinas" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Fábricas Abandonadas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValFactories" Text="Ninguna" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Nivel de Radiación:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValRad" Text="0.0" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Polvo Atmosférico:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValDust" Text="0.0" Foreground="White" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Escaneo Geológico:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblValSurvey" Text="✅ Completa" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Column 4: Colonization Viability -->
                                    <Border Grid.Column="3" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2" ToolTip="Viabilidad biológica y multiplicador de infraestructura requerida para colonización.">
                                        <StackPanel>
                                            <TextBlock Text="🚀 COLONIZACIÓN &amp; HÁBITAT" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                            <Grid Margin="0,1"><TextBlock Text="Costo Colonial:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblColonyCostVal" Text="★ 0.00 (Ideal)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Tolerancia G:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblGravSuitability" Text="Tolerable (1.00 G)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Ajuste Atmosférico:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblAtmosReq" Text="Nulo (1.0 atm)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                            <Grid Margin="0,1"><TextBlock Text="Ajuste Térmico:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock x:Name="LblTempReq" Text="Temperatura Ideal" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Card 4: Imperial Exploration Advisor & Recommended Next Steps -->
                                <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 ASESOR IMPERIAL DE EXPLORACIÓN Y PRÓXIMOS PASOS RECOMENDADOS" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="LblExplorationAdvisor" Text="💡 CONSEJO TÁCTICO: Explora primero cuerpos con Colony Cost 0.00 para establecer colonias de baja infraestructura. Si detectas yacimientos de Sorium y Gallicite con accesibilidad > 0.8, asigna Minas Automáticas de inmediato." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Prospecting Actions & Live Commands -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="⚓ MISIONES Y ACCIONES DE PROSPECCIÓN EN VIVO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🌍 Marcar como Objetivo Colonial" Click="BtnSetColonyTarget_Click" Padding="10,8" Margin="0,0,4,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Designa este planeta como destino prioritario para cargueros de infraestructura y naves colonizadoras en AuroraDB.db."/>
                                    <Button Grid.Column="1" Content="🚀 Enviar Flota de Prospección Geológica" Click="BtnSendSurveyFleet_Click" Padding="10,8" Margin="4,0,0,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" ToolTip="Asigna a tu flota exploradora (Survey Fleet) la orden de escanear minuciosamente este planeta."/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- MODE 2: JUMP POINTS TOPOLOGY -->
            <Grid x:Name="PnlJumpPoints" Visibility="Collapsed">
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="🌀 RED DE PUNTOS DE SALTO INTERESTELARES (JUMP POINTS)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <DataGrid x:Name="DgJumpPoints" AutoGenerateColumns="False" IsReadOnly="True" ToolTip="Nodos de salto warp detectados por sensores de prospección gravitatoria en los sistemas explorados.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Punto de Salto ID" Binding="{Binding JumpPointID}" Width="140"/>
                                <DataGridTextColumn Header="Sistema Destino" Binding="{Binding DestinationSystemName}" Width="*"/>
                                <DataGridTextColumn Header="Tipo de Conexión" Binding="{Binding GateDisplay}" Width="220"/>
                                <DataGridTextColumn Header="Estado Prospección" Binding="{Binding StatusDisplay}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- MODE 3: ACTIVE SURVEY FLEETS -->
            <Grid x:Name="PnlSurveyFleets" Visibility="Collapsed">
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="🛸 BUQUES Y ESCUADRAS DE PROSPECCIÓN EN SERVICIO" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <DataGrid x:Name="DgSurveyFleets" AutoGenerateColumns="False" IsReadOnly="True" ToolTip="Escuadras exploradoras equipadas con sensores geológicos y gravitatorios activos.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre de Flota / Nave" Binding="{Binding FleetName}" Width="*"/>
                                <DataGridTextColumn Header="Cantidad de Naves" Binding="{Binding ShipsDisplay}" Width="150"/>
                                <DataGridTextColumn Header="Velocidad" Binding="{Binding SpeedDisplay}" Width="150"/>
                                <DataGridTextColumn Header="Reserva Combustible" Binding="{Binding FuelDisplay}" Width="150"/>
                                <DataGridTextColumn Header="Ubicación Actual" Binding="{Binding SystemLocation}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
