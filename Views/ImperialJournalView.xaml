<UserControl x:Class="AuroraDesignSuite.Views.ImperialJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Column Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource BorderBrush}" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Left Column: Search, Filter, Notes List & Quick New Note Button -->
        <Grid Grid.Column="0" Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Header -->
            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock Text="📜 DIARIO DE MANDO Y BITÁCORA IMPERIAL" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="➕ Nueva Nota" Click="BtnNewEntry_Click" Padding="8,4" HorizontalAlignment="Right" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                </DockPanel>
            </Border>

            <!-- Card 2: Filter & Search -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBox x:Name="TxtSearchJournal" TextChanged="TxtSearchJournal_TextChanged" Padding="6,4" Margin="0,0,0,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="11" ToolTip="Filtra tus notas imperiales por título, categoría o texto."/>
                    <ComboBox x:Name="CboCategoryFilter" SelectionChanged="CboCategoryFilter_SelectionChanged" Padding="6,4">
                        <ComboBoxItem Content="🌟 Todas las Categorías" IsSelected="True"/>
                        <ComboBoxItem Content="⚔️ Misión Militar"/>
                        <ComboBoxItem Content="🏭 Plan Industrial"/>
                        <ComboBoxItem Content="🔬 Investigación I+D"/>
                        <ComboBoxItem Content="🌌 Exploración"/>
                        <ComboBoxItem Content="📜 Novela de Rol"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Card 3: Notes List -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <ListBox x:Name="LstJournalEntries" SelectionChanged="LstJournalEntries_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,3" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding PriorityBadge}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding FormattedDate}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" Margin="0,2,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Card 4: Global Actions -->
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <Button Content="💾 Exportar Bitácora Completa (.md)" Click="BtnExportMarkdown_Click" Padding="10,6" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
            </StackPanel>
        </Grid>

        <!-- Right Column: Note Editor / Reader -->
        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="4,0,0,0">
            <Grid x:Name="PnlEditor">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Note Header Inputs -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Título de la Nota / Directiva Imperial:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtEditTitle" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Categoría:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CboEditCategory" Padding="6,4">
                            <ComboBoxItem Content="⚔️ Misión Militar" IsSelected="True"/>
                            <ComboBoxItem Content="🏭 Plan Industrial"/>
                            <ComboBoxItem Content="🔬 Investigación I+D"/>
                            <ComboBoxItem Content="🌌 Exploración"/>
                            <ComboBoxItem Content="📜 Novela de Rol"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Prioridad:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CboEditPriority" Padding="6,4">
                            <ComboBoxItem Content="Alta"/>
                            <ComboBoxItem Content="Media" IsSelected="True"/>
                            <ComboBoxItem Content="Baja"/>
                            <ComboBoxItem Content="Crítica"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ChkEditCompleted" Grid.Row="1" Content="✅ Marcar como Directiva Completada" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>

                <!-- Content Text Area -->
                <Border Grid.Row="2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,10">
                    <TextBox x:Name="TxtEditContent" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="12"/>
                </Border>

                <!-- Save & Delete Buttons -->
                <DockPanel Grid.Row="3">
                    <Button Content="🗑️ Eliminar Nota" Click="BtnDeleteEntry_Click" Padding="10,6" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentRedBrush}" BorderBrush="{DynamicResource AccentRedBrush}" FontWeight="Bold" FontSize="11"/>
                    <Button Content="💾 Guardar Cambios" Click="BtnSaveEntry_Click" Padding="14,6" HorizontalAlignment="Right" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
