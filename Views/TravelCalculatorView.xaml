                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="2,0,2,0">
                                    <TextBlock Text="Vel Misil Enemigo:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
