                                    <TextBox x:Name="TxtFormulaSciBonus" Text="30" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" FontWeight="Bold" FontSize="11"/>
