<UserControl x:Class="AuroraDesignSuite.Views.TravelCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1300">
    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Card 0: Guidance & Instructions Header Banner -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1.5" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="🛠️ AUDITORÍA Y SUITE MASTER DE HERRAMIENTAS DE CÁLCULO AURORA 4X (20 HERRAMIENTAS)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnToggleCalculators" Click="BtnToggleCalculators_Click" Content="👁️ Ocultar Calculadoras" Padding="8,4" Margin="0,0,8,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                <Button x:Name="BtnSelectCalculators" Click="BtnSelectCalculators_Click" Content="🎛️ Selector de Calculadoras (20/20) 🔻" Padding="8,4" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Matriz de simulación balística, cinemática, biomasa, astilleros e ingeniería financiera. Ajusta múltiples parámetros para obtener diagnósticos tácticos y recomendaciones imperiales en tiempo real:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- POPUP / DRAWER SELECTOR PANEL -->
                <Border x:Name="PnlCalculatorSelector" Visibility="Collapsed" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="⚙️ SELECCIONA QUÉ HERRAMIENTAS DE CÁLCULO MANTENER VISIBLES EN PANTALLA:" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="BtnCheckAll_Click" Content="✅ Seleccionar Todas" Padding="6,2" Margin="0,0,6,0" Background="Transparent" Foreground="{DynamicResource AccentGreenBrush}" BorderThickness="0" FontSize="10.5" Cursor="Hand"/>
                                <Button Click="BtnUncheckAll_Click" Content="❌ Desmarcar Todas" Padding="6,2" Margin="0,0,6,0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontSize="10.5" Cursor="Hand"/>
                                <Button Click="BtnResetDefault_Click" Content="🔄 Predeterminado" Padding="6,2" Background="Transparent" Foreground="{DynamicResource AccentCyanBrush}" BorderThickness="0" FontSize="10.5" Cursor="Hand"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- 20 Modular CheckBoxes in 2 Columns -->
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <CheckBox x:Name="ChkCalc1" Content="💥 1. Penetración de Blindaje &amp; Ojiva" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc2" Content="📡 2. Alcance Máximo Radar Activo" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc3" Content="⛽ 3. Consumo Combustible &amp; Impulso" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc4" Content="🏗️ 4. Tiempo &amp; Costo Retooling Astilleros" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc5" Content="🚀 5. Velocidad Máxima Naval (EP/HS)" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc6" Content="🌌 6. Autonomía &amp; Consumo (AU/Bkm)" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc7" Content="🔧 7. Tasa de Fallos (AFR) &amp; Pañol MSP" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc8" Content="🌍 8. Costo Colonial Planetario" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc9" Content="⛏️ 9. Producción Minera &amp; Rendimiento" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc10" Content="🛰️ 10. Detección Pasiva Térmica &amp; Sigilo" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc11" Content="🛡️ 11. Potencia &amp; Recarga de Escudos" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc12" Content="⚡ 12. Recarga Capacitores &amp; Armas Láser" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc13" Content="🎯 13. Probabilidad de Impacto de Misil" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc14" Content="🏭 14. Capacidad Construcción Industrial" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc15" Content="🛰️ 15. Detección Pasiva Electromagnética" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc16" Content="🚀 16. Logística de Catapulta de Masa" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc17" Content="🎓 17. Puntos de Investigación RP/Año" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc18" Content="💣 18. Defensa Antimisil de Área &amp; CIWS" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc19" Content="⚓ 19. Capacidad Mantenimiento Naval" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                            <CheckBox x:Name="ChkCalc20" Content="💵 20. Generación de Riqueza Imperial" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- MAIN CALCULATORS CONTAINER -->
                <StackPanel x:Name="PnlCalculatorsContainer">

                    <!-- Formula 1: Missile Penetration vs Enemy Armor -->
                    <Border x:Name="CardCalc1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="💥 1. Penetración de Blindaje y Daño de Ojiva (Missile Penetration vs Enemy Armor)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Compara la potencia de tu ojiva (Yield) contra las capas de blindaje enemigas. En Aurora 4X, un misil perfora un cráter cuadrado de prof = sqrt(Yield). Ingresa ambos datos para verificar si atravesarás su casco y destruirás sus componentes internos." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Potencia Ojiva Misil (Yield Points):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaWarheadYield" Text="16" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Capas de Blindaje Nave Enemiga:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaEnemyArmor" Text="6" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="10,6">
                                <TextBlock x:Name="LblFormulaWarheadResult" Text="Calculando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Formula 2: Active Sensor Range vs Target -->
                    <Border x:Name="CardCalc2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📡 2. Alcance Máximo de Radar Activo (Active Sensor vs Target Tonnage)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula a qué distancia tu radar fijará un blanco según su tamaño en HS (1 HS = 50 tons) y la resolución del sensor. La Res 1 detecta misiles/cazas; Res 100 optimiza alcance contra cruceros pesados." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Fuerza del Radar (Strength):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaRadarStrength" Text="24" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                    <TextBlock Text="Resolución (Res 1-100):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaRadarRes" Text="100" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="Tamaño Blanco Enemigo (HS):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaTargetHS" Text="100" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="10,6">
                                <TextBlock x:Name="LblFormulaRadarResult" Text="Calculando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Formula 3: Fleet Engine Burn & Tanker Logistics -->
                    <Border x:Name="CardCalc3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="⛽ 3. Consumo de Combustible &amp; Logística de Flotas (Fleet Engine Burn &amp; Tankers)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula el consumo total de combustible para una flota completa durante días de misión continua. Indica cuántas naves cisterna (1 Cisterna = 1,000,000 L) se requieren para soportar el despliegue." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                    <TextBlock Text="Empuje Motor (EP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaEngineEP" Text="500" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                    <TextBlock Text="Consumo (L/EP/h):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaEngineFuelRate" Text="0.8" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="2,0,2,0">
                                    <TextBlock Text="Naves en Flota:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaFleetShips" Text="12" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="2,0,0,0">
                                    <TextBlock Text="Días de Misión:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaMissionDays" Text="30" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="10,6">
                                <TextBlock x:Name="LblFormulaEngineResult" Text="Calculando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Formula 4: Shipyard Retooling & Refit -->
                    <Border x:Name="CardCalc4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🏗️ 4. Tiempo &amp; Costo de Retooling de Astilleros (Shipyard Retooling)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula los Puntos de Construcción (BP) y días para reequipar gradas navales. Si la nueva nave es variante de la anterior (0-20% diff), el tiempo se reduce drásticamente." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Capacidad Astillero (Tons):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaRetoolCapacity" Text="10000" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                    <TextBlock Text="Dif. Diseño (0-100%):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaRetoolDiff" Text="20" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="BP/Año por Grada:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaRetoolBP" Text="500" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="10,6">
                                <TextBlock x:Name="LblFormulaRetoolResult" Text="Calculando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Formula 5: Naval Speed & Interception -->
                    <Border x:Name="CardCalc5" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🚀 5. Velocidad Máxima Naval &amp; Intercepción (Naval Speed vs Target)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula la velocidad máxima propia en km/s (EP/HS * 1000) y la compara contra la velocidad de la flota enemiga para determinar si tienes ventaja táctica de intercepción o huida." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Empuje Motor (EP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaSpeedEP" Text="1200" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                    <TextBlock Text="Masa Casco (HS):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaSpeedHS" Text="300" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="Velocidad Enemiga (km/s):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaEnemySpeed" Text="3500" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="10,6">
                                <TextBlock x:Name="LblFormulaSpeedResult" Text="Calculando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Formula 6: Flight Endurance & Safe Return Radius -->
                    <Border x:Name="CardCalc6" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🌌 6. Autonomía &amp; Radio Operativo de Retorno Seguro (Flight Endurance &amp; Radius)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Mide el alcance máximo de navegación continua en Bkm/AU y calcula el Radio de Retorno Seguro (50% de reserva) para asegurar que tus patrullas regresen a su base." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Combustible Total (L):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaRangeFuel" Text="500000" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                    <TextBlock Text="Consumo (L/hora):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaRangeRate" Text="400" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
