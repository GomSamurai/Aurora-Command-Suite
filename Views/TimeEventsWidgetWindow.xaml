<Window x:Class="AuroraDesignSuite.Views.TimeEventsWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⏱️ Widget Temporal y Eventos - Aurora Command Suite" 
        Height="640" Width="860" MinHeight="420" MinWidth="750"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" WindowStartupLocation="CenterScreen">

    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1.5" CornerRadius="8">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Live Calendar Header -->
                <RowDefinition Height="Auto"/>
                <!-- Time Passage Controls -->
                <RowDefinition Height="Auto"/>
                <!-- Auto Advance Panel -->
                <RowDefinition Height="Auto"/>
                <!-- Event Feed Controls & Filter -->
                <RowDefinition Height="Auto"/>
                <!-- Live Event List -->
                <RowDefinition Height="*"/>
                <!-- Footer & Settings -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. Title Bar (Draggable) -->
            <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏱️ CHRONOS WIDGET" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13.5"/>
                    <Border Background="#1A1E29" CornerRadius="3" Padding="8,3" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtStatusPill" Text="🟢 EN TIEMPO REAL" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10.5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Always On Top Toggle -->
                    <Button x:Name="BtnPinTopmost" Content="📌 SIEMPRE ENCIMA" Click="BtnPinTopmost_Click" Padding="10,3" Height="24" FontSize="9.5" FontWeight="Bold" Background="#161B26" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" Margin="0,0,6,0" ToolTip="Mantener esta ventana siempre encima de otras."/>
                    <!-- Compact/Detailed View Toggle -->
                    <Button x:Name="BtnToggleCompact" Content="🗖 MODO COMPACTO" Click="BtnToggleCompact_Click" Padding="10,3" Height="24" FontSize="9.5" FontWeight="Bold" Background="#161B26" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" Margin="0,0,6,0" ToolTip="Conmutar entre Vista Detallada de Eventos o Modo Barra Compacta."/>
                    <!-- Close Button -->
                    <Button Content="✕" Click="BtnClose_Click" Width="28" Height="24" FontSize="11" FontWeight="Bold" Background="#4A151B" Foreground="#FF4A4A" BorderBrush="#FF4A4A" ToolTip="Cerrar Widget."/>
                </StackPanel>
            </Grid>

            <!-- 1. Live Calendar Header -->
            <Border Grid.Row="1" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,7" Margin="0,0,0,8">
                <UniformGrid Columns="3">
                    <StackPanel ToolTip="Fecha y hora actual dentro del universo de juego.">
                        <TextBlock Text="📅 Fecha Actual Juego:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="TxtCurrentDate" Text="20/10/2037 08:00" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="13.5"/>
                    </StackPanel>

                    <StackPanel ToolTip="Año de inicio y tiempo de vida transcurrido del imperio.">
                        <TextBlock Text="⏳ Antigüedad Imperial:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="TxtLifetime" Text="Inicio: 2026 (11.8 a. vida)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13.5"/>
                    </StackPanel>

                    <StackPanel ToolTip="Nombre del Imperio en directo.">
                        <TextBlock Text="🏛️ Imperio:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock x:Name="TxtEmpireName" Text="El Imperio" Foreground="White" FontWeight="Bold" FontSize="13.5"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- 2. Time Passage Controls (Barra de Tiempo de 11 Columnas Espaciosa) -->
            <Border Grid.Row="2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,7" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="⚡ AVANZA EL TIEMPO EN DIRECTO (PASOS RÁPIDOS)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="10.5" Margin="2,0,0,6"/>
                    <UniformGrid Columns="11" x:Name="PnlTimeButtons">
                        <Button Content="+5 Seg" Click="BtnTimeStep_Click" Tag="5" Height="26" Margin="2" FontSize="10.5" Background="#1B2230" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}"/>
                        <Button Content="+30 Seg" Click="BtnTimeStep_Click" Tag="30" Height="26" Margin="2" FontSize="10.5" Background="#1B2230" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}"/>
                        <Button Content="+5 Min" Click="BtnTimeStep_Click" Tag="300" Height="26" Margin="2" FontSize="10.5" Background="#1B2230" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}"/>
                        <Button Content="+20 Min" Click="BtnTimeStep_Click" Tag="1200" Height="26" Margin="2" FontSize="10.5" Background="#1B2230" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}"/>
                        <Button Content="+1 Hora" Click="BtnTimeStep_Click" Tag="3600" Height="26" Margin="2" FontSize="10.5" Background="#1B2230" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}"/>
                        <Button Content="+3 Horas" Click="BtnTimeStep_Click" Tag="10800" Height="26" Margin="2" FontSize="10.5" Background="#1B2230" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}"/>
                        <Button Content="+8 Horas" Click="BtnTimeStep_Click" Tag="28800" Height="26" Margin="2" FontSize="10.5" Background="#1B2230" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}"/>
                        <Button Content="+1 Día" Click="BtnTimeStep_Click" Tag="86400" Height="26" Margin="2" FontSize="10.5" FontWeight="Bold" Background="#232C3D" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}"/>
                        <Button Content="+5 Días" Click="BtnTimeStep_Click" Tag="432000" Height="26" Margin="2" FontSize="10.5" FontWeight="Bold" Background="#232C3D" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}"/>
                        <Button Content="+30 Días" Click="BtnTimeStep_Click" Tag="2592000" Height="26" Margin="2" FontSize="10.5" FontWeight="Bold" Background="#232C3D" Foreground="#FF9800" BorderBrush="#FF9800"/>
                        <Button Content="+1 Año" Click="BtnTimeStep_Click" Tag="31536000" Height="26" Margin="2" FontSize="10.5" FontWeight="Bold" Background="#2A1B24" Foreground="#FF5722" BorderBrush="#FF5722"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 3. Auto Advance Engine Controls -->
            <Border Grid.Row="3" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Toggle Auto Advance Button -->
                    <Button x:Name="BtnToggleAutoPass" Content="▶️ AUTO-AVANZAR" Click="BtnToggleAutoPass_Click" Width="155" Height="30" FontSize="11" FontWeight="Bold" Background="#183823" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" Margin="0,0,14,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="⚡ Velocidad:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbAutoSpeed" Width="120" Height="22" FontSize="9.5" SelectionChanged="CmbAutoSpeed_SelectionChanged" Margin="0,0,14,0">
                                <ComboBoxItem Content="⚡ 0.5s / ciclo"/>
                                <ComboBoxItem Content="⏱️ 1.0s / ciclo" IsSelected="True"/>
                                <ComboBoxItem Content="🐢 2.0s / ciclo"/>
                                <ComboBoxItem Content="🐌 5.0s / ciclo"/>
                            </ComboBox>

                            <TextBlock Text="⏩ Incremento:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbAutoStep" Width="110" Height="22" FontSize="9.5" SelectionChanged="CmbAutoStep_SelectionChanged">
                                <ComboBoxItem Content="+5 Seg"/>
                                <ComboBoxItem Content="+1 Hora"/>
                                <ComboBoxItem Content="+1 Día" IsSelected="True"/>
                                <ComboBoxItem Content="+5 Días"/>
                                <ComboBoxItem Content="+30 Días"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Auto Stop Checkboxes -->
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkStopOnCombat" Content="🔴 Detener en Combate / Alerta" IsChecked="True" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkStopOnResearch" Content="🔬 Detener en Avances I+D" IsChecked="True" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Event Feed Filters Header -->
            <Grid Grid.Row="4" x:Name="PnlEventsFilterHeader" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📡 VENTANA DE EVENTOS Y REGISTROS IMPERIALES" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                    <TextBlock x:Name="TxtEventCount" Text="(0 eventos)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0">
                    <TextBlock Text="Filtro:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbEventCategoryFilter" Width="170" Height="22" FontSize="9.5" SelectionChanged="CmbEventCategoryFilter_SelectionChanged">
                        <ComboBoxItem Content="Todas las Categorías" IsSelected="True"/>
                        <ComboBoxItem Content="🔴 Combate"/>
                        <ComboBoxItem Content="🔬 Investigación e Industria"/>
                        <ComboBoxItem Content="⚓ Flota y Oficiales"/>
                        <ComboBoxItem Content="🪐 Exploración"/>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnRefreshEvents" Content="🔄 Refrescar" Click="BtnRefreshEvents_Click" Padding="12,2" Height="22" FontSize="9.5" Background="#161B26" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}"/>
            </Grid>

            <!-- 5. Live Event List -->
            <Border Grid.Row="5" x:Name="PnlEventListBorder" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="4">
                <ListBox x:Name="LstGameEvents" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#121620" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Icon -->
                                    <TextBlock Text="{Binding CategoryIcon}" FontSize="12.5" VerticalAlignment="Center"/>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center"/>

                                    <!-- Event Type Badge -->
                                    <Border Grid.Column="2" Background="#1A2233" CornerRadius="3" Padding="6,2" Margin="2,0,8,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding EventTypeDescription}" Foreground="{Binding CategoryColor}" FontWeight="Bold" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- Message Text -->
                                    <TextBlock Grid.Column="3" Text="{Binding MessageText}" Foreground="White" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 6. Footer & Opacity Slider -->
            <Grid Grid.Row="6" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Transparencia Widget:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="SldOpacity" Minimum="0.5" Maximum="1.0" Value="1.0" Width="110" ValueChanged="SldOpacity_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtOpacityValue" Text="100%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="⚡ Sincronizado en tiempo real con Aurora 4X" Foreground="{DynamicResource AccentGreenBrush}" FontSize="9.5" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
