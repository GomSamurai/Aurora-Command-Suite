<Window x:Class="AuroraDesignSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AuroraDesignSuite.Views"
        mc:Ignorable="d"
        Title="Aurora 4X - Design &amp; Empire Command Center Master Suite (12 Módulos en Vivo)" 
        Height="880" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid Background="{DynamicResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Top Header Bar with Global Empire Selector & Live Bridge Status -->
        <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀 AURORA MASTER COMMAND SUITE" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                        <TextBlock Text="v2.7.1 LIVE BRIDGE (12 MÓDULOS)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="10.5"/>
                    </Border>
                </StackPanel>

                <!-- Unified Imperial Command Telemetry Header Panel -->
                <Border Grid.Column="1" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Panel Unificado de Comando Imperial: Selector de Imperio activo, Fecha actual del juego, Antigüedad de la dinastía y Conexión a Base de Datos.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 1. Empire Selector -->
                        <TextBlock Text="👑 IMPERIO:" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbGlobalEmpire" SelectionChanged="CmbGlobalEmpire_SelectionChanged" Width="185" VerticalAlignment="Center" ToolTip="Selecciona el Imperio de tu partida actual cuyos datos deseas conectar en toda la suite."/>

                        <!-- Vertical Divider -->
                        <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="10,0"/>

                        <!-- 2. Game Date -->
                        <TextBlock Text="📅 FECHA:" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtHeaderGameDate" Text="Cargando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>

                        <!-- Vertical Divider -->
                        <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="10,0"/>

                        <!-- 3. Start Year & Service Lifetime -->
                        <TextBlock Text="🏛️ INICIO:" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtHeaderStartYear" Text="2026 (0.0 a. de servicio)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>

                        <!-- Vertical Divider -->
                        <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="10,0"/>

                        <!-- 4. Change DB Button -->
                        <Button Content="📁 BD" Click="BtnChangeDb_Click" Padding="6,2" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10" ToolTip="Selecciona el archivo AuroraDB.db de cualquier otra carpeta."/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="STATUS: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="● CONECTADO" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>

                    <TextBlock Text="🎨 ESTILO VISUAL:" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <ComboBox x:Name="CmbThemeSelector" SelectionChanged="CmbThemeSelector_SelectionChanged" Width="220" VerticalAlignment="Center" ToolTip="Cambia drásticamente la paleta de colores y el esquema visual de toda la aplicación en tiempo real.">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentAmberBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource CardHeaderBrush}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,4,4,4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <Button Content="🎮 VOLVER A AURORA 4X" Click="BtnFocusGame_Click" Padding="10,4" Margin="14,0,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" ToolTip="Enfoca al instante la ventana del juego Aurora 4X en primer plano."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Vertical Sidebar Navigation Dock & Main Content Area -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" TabStripPlacement="Left" SelectionChanged="MainTabControl_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="6">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Margin" Value="0,3"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid Margin="0,3,0,3">
                                    <Border x:Name="BdrTab" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Active Left Bar Indicator -->
                                            <Border x:Name="IndBar" Grid.Column="0" Background="Transparent" CornerRadius="2" Margin="0,1,6,1"/>

                                            <ContentPresenter Grid.Column="1" x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="BdrTab" Property="Background" Value="{DynamicResource CardHeaderBrush}"/>
                                        <Setter TargetName="BdrTab" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}"/>
                                        <Setter TargetName="IndBar" Property="Background" Value="{DynamicResource AccentCyanBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BdrTab" Property="Background" Value="{DynamicResource CardHeaderBrush}"/>
                                        <Setter TargetName="BdrTab" Property="BorderBrush" Value="{DynamicResource AccentAmberBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="275" MinWidth="230" MaxWidth="380"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Sidebar Navigation Dock Container -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Left Sidebar Header Banner -->
                                <Border Grid.Row="0" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="❖ CONSOLA DE COMANDO" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Right">
                                            <TextBlock Text="12 MÓDULOS" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="9.5"/>
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <!-- Scrollable Vertical Tab Panel (StackPanel prevents WPF TabPanel border clipping) -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>

                                <!-- Bottom Sidebar Action: Time & Events Widget -->
                                <Border Grid.Row="2" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1.5" CornerRadius="6" Padding="3" Margin="0,8,0,0">
                                    <Button x:Name="BtnOpenTimeEventsWidget" Click="BtnOpenTimeEventsWidget_Click" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" Padding="6,6" Cursor="Hand" ToolTip="Abre el Widget Flotante Always-On-Top de Control del Tiempo y Feed de Eventos.">
                                        <DockPanel LastChildFill="True">
                                            <Border Width="26" Height="26" CornerRadius="5" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" Margin="0,0,8,0">
                                                <TextBlock Text="⏱️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="WIDGET TIEMPO &amp; EVENTOS" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Text="📌 Always-On-Top + Auto-Paso" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="9"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- GridSplitter for Resizing Navigation Dock -->
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True" ToolTip="Arrastra horizontalmente para redimensionar el menú de navegación izquierdo"/>

                        <!-- Main Display View -->
                        <Border Grid.Column="2" Background="Transparent" Margin="2,0,0,0">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ========================================== -->
            <!-- CATEGORÍA 1: GOBIERNO IMPERIAL & TERRITORIO -->
            <!-- ========================================== -->
            <TabItem x:Name="TabEmpire">
                <TabItem.Header>
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,2,2,4" Margin="0,0,0,6">
                            <TextBlock Text="🏛️ GOBIERNO &amp; TERRITORIO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <DockPanel LastChildFill="True">
                            <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="🏰" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Mi Imperio" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </TabItem.Header>
                <views:EmpireOverviewView x:Name="ViewEmpire"/>
            </TabItem>

            <TabItem x:Name="TabColonies">
                <TabItem.Header>
                    <DockPanel LastChildFill="True">
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="🪐" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Colonias y Minerales" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </TabItem.Header>
                <views:ColoniesOverviewView x:Name="ViewColonies"/>
            </TabItem>

            <TabItem x:Name="TabCommanders">
                <TabItem.Header>
                    <DockPanel LastChildFill="True">
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="🎖️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Alto Mando &amp; Líderes" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </TabItem.Header>
                <views:CommandersHQView x:Name="ViewCommanders"/>
            </TabItem>

            <!-- ========================================== -->
            <!-- CATEGORÍA 2: CIENCIA E INDUSTRIA           -->
            <!-- ========================================== -->
            <TabItem x:Name="TabResearch">
                <TabItem.Header>
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="2,4,2,4" Margin="0,8,0,6">
                            <TextBlock Text="🔬 CIENCIA &amp; PRODUCCIÓN" Foreground="{DynamicResource AccentPurpleBrush}" FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <DockPanel LastChildFill="True">
                            <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentPurpleBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="🔬" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Investigación I+D" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </TabItem.Header>
                <views:ResearchHQView x:Name="ViewResearch"/>
            </TabItem>

            <TabItem x:Name="TabIndustrial">
                <TabItem.Header>
                    <DockPanel LastChildFill="True">
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="⚡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Industria &amp; Fábricas" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </TabItem.Header>
                <views:IndustrialHQView x:Name="ViewIndustrial"/>
            </TabItem>

            <TabItem x:Name="TabShipyards">
                <TabItem.Header>
                    <DockPanel LastChildFill="True">
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="🏭" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Operaciones Astillero" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </TabItem.Header>
                <views:ShipyardOperationsView x:Name="ViewShipyards"/>
            </TabItem>

            <!-- ========================================== -->
            <!-- CATEGORÍA 3: FLOTAS Y DISEÑO NAVAL        -->
            <!-- ========================================== -->
            <TabItem x:Name="TabBlueprint">
                <TabItem.Header>
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="2,4,2,4" Margin="0,8,0,6">
                            <TextBlock Text="🛸 FLOTAS &amp; DISEÑO NAVAL" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <DockPanel LastChildFill="True">
                            <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="🛠️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Diseñador de Naves" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </TabItem.Header>
                <views:BlueprintDesignerView x:Name="ViewBlueprint"/>
            </TabItem>

            <TabItem x:Name="TabMissile">
                <TabItem.Header>
                    <DockPanel LastChildFill="True">
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="🧪" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Proyectos I+D" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </TabItem.Header>
                <views:MissileEngineLabView x:Name="ViewMissile"/>
            </TabItem>

            <TabItem x:Name="TabActiveFleets">
                <TabItem.Header>
                    <DockPanel LastChildFill="True">
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="🛸" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Mis Flotas &amp; Naves" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </TabItem.Header>
                <views:ActiveFleetsView x:Name="ViewActiveFleets"/>
            </TabItem>

            <TabItem x:Name="TabFleet">
                <TabItem.Header>
                    <DockPanel LastChildFill="True">
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="⚓" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Auditoría Naval" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </TabItem.Header>
                <views:FleetCompositionView x:Name="ViewFleet"/>
            </TabItem>

            <TabItem x:Name="TabExploration">
                <TabItem.Header>
                    <DockPanel LastChildFill="True">
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="🌌" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Exploración &amp; Sistemas" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </TabItem.Header>
                <views:SystemExplorationView x:Name="ViewExploration"/>
            </TabItem>

            <!-- ========================================== -->
            <!-- CATEGORÍA 4: HERRAMIENTAS Y AUDITORÍA     -->
            <!-- ========================================== -->
            <TabItem x:Name="TabCalculators">
                <TabItem.Header>
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="2,4,2,4" Margin="0,8,0,6">
                            <TextBlock Text="📐 AUDITORÍA &amp; HERRAMIENTAS" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="10"/>
                        </Border>
                        <DockPanel LastChildFill="True">
                            <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="📐" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Auditoría y Herramientas" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </TabItem.Header>
                <views:TravelCalculatorView x:Name="ViewCalculators"/>
            </TabItem>

            <!-- ========================================== -->
            <!-- CATEGORÍA 5: ASESOR IMPERIAL SUPREMO (IA) -->
            <!-- PESTAÑA FINAL DIVERSIFICADA Y VIP         -->
            <!-- ========================================== -->
            <TabItem x:Name="TabAI" ToolTip="Matriz Computacional de Inteligencia Táctica conectada al Imperio">
                <TabItem.Header>
                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Special Glowing VIP Category Header Banner -->
                        <Border Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,14,0,6">
                            <DockPanel>
                                <TextBlock Text="✨ INTELIGENCIA IMPERIAL (IA)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="9.5" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentCyanBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                    <TextBlock Text="ASESOR VIP" Foreground="Black" FontWeight="Bold" FontSize="8.5"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Special High-Tech VIP Box for AI Tab -->
                        <Border Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1.5" CornerRadius="6" Padding="8,6">
                            <DockPanel LastChildFill="True">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" Margin="0,0,8,0">
                                    <TextBlock Text="🧠" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MATRIZ TÁCTICA DE IA" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Inteligencia Imperial Asistida" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="9"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:AIAssistantView x:Name="ViewAI"/>
            </TabItem>
        </TabControl>

        <!-- Row 2: Footer Bar -->
        <Border Grid.Row="2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <TextBlock Text="Aurora 4X Design &amp; Empire Command Center Master Suite | Aurora 4X v2.7.1 | C# WPF Live Bridge (12 Módulos)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                <TextBlock Text="👑 Creado por Fran Gómez &amp; Antigravity AI | © 2026 Aurora Master Suite" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
