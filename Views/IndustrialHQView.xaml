<UserControl x:Class="AuroraDesignSuite.Views.IndustrialHQView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Installations & Projects -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Card: Installations DataGrid -->
            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🏗️ INSTALACIONES INDUSTRIALES Y FÁBRICAS ACTIVAS EN TU IMPERIO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgInstallations" AutoGenerateColumns="False" IsReadOnly="True" ToolTip="Instalaciones planetarias reales vs objetivos recomendados para tu población imperial.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Instalación Industrial" Binding="{Binding InstallationName}" Width="200"/>
                            <DataGridTextColumn Header="Cantidad Actual" Binding="{Binding AmountDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Objetivo Recomendado" Binding="{Binding RecommendedDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Evaluación &amp; Estado" Binding="{Binding StatusBadge}" Width="130"/>
                            <DataGridTextColumn Header="Recomendación Táctica" Binding="{Binding RecommendationHint}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Middle Card: Projects DataGrid -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="⚡ PROYECTOS Y ÓRDENES INDUSTRIALES EN CURSO" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgIndustrialProjects" AutoGenerateColumns="False" IsReadOnly="True" ToolTip="Proyectos de construcción industrial en curso.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proyecto / Construcción" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Cantidad Unidades" Binding="{Binding AmountDisplay}" Width="140"/>
                            <DataGridTextColumn Header="Progreso BP" Binding="{Binding ProgressDisplay}" Width="200"/>
                            <DataGridTextColumn Header="Estado Operativo" Binding="{Binding StatusDisplay}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Action Toolbar -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙️ ACCIONES INDUSTRIALES DIRECTAS EN BASE DE DATOS:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="❌ Cancelar Proyecto" Click="BtnCancelProject_Click" Padding="10,6" Margin="0,0,8,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentRedBrush}" BorderBrush="{DynamicResource AccentRedBrush}" FontWeight="Bold"/>
                        <Button Content="🚀 Asignar Nueva Orden de Construcción" Click="BtnNewIndustrialOrder_Click" Padding="12,6" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Column: Industrial Telemetry, Strategic Advisor & Calculator -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Card 1: Imperial Industrial Telemetry -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📊 TELEMETRÍA INDUSTRIAL IMPERIAL" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Población Imperial Total:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblTotalPopulation" Text="1,168 Millones" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Capacidad Producción BP/Año:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblTotalBPOutput" Text="0 BP / Año" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Fábricas de Construcción Activas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblConstructionFactories" Text="0 Fábricas" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Fábricas de Misiles y Cazas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblOrdnanceFactories" Text="0 Fábricas" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Refinerías de Sorium Activas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblFuelRefineries" Text="0 Refinerías" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Capacidad Minera Imperial:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblMiningCapacity" Text="0 Minas" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <TextBlock Text="Bonificación de Gobernador:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblGovBonus" Text="+10.0%" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Imperial Strategic Recommendation Advisor -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💡 ASESOR DE PLANIFICACIÓN IMPERIAL" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock Text="Evaluación estratégica basada en la población y desarrollo actual de tu civilización:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="🏗️ Conversión de Industria Convencional" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock x:Name="LblAdviceConversion" Text="Tu imperio dispone de 1.594 Industrias Convencionales. Se recomienda convertirlas a Fábricas de Construcción y Minas para multiplicar por x10 la producción." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                            <StackPanel>
                                <TextBlock Text="⛽ Almacenamiento y Logística de Combustible" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock x:Name="LblAdviceRefinery" Text="Se recomiendan entre 15 y 20 Refinerías de Sorium para respaldar el consumo de las escuadras militares e industriales." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 3: Industrial Build Time & Throughput Calculator -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🧮 CALCULADORA DE TIEMPOS DE FABRICACIÓN" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Costo de Construcción Objetivo (BP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtTargetBP" Text="120.0" TextChanged="OnCalcInputChanged" Margin="0,0,0,8" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Fábricas de Construcción Asignadas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtAssignedFactories" Text="100" TextChanged="OnCalcInputChanged" Margin="0,0,0,10" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Rendimiento Anual:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock x:Name="LblCalcAnnualBP" Text="1,000 BP/Año" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Tiempo Estimado Construcción:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock x:Name="LblCalcDays" Text="44 Días (1.4 Meses)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 4: Construction Exotic Mineral Requirements -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="💎 CONSUMO ESTIMADO DE MINERALES EN CONSTRUCCIÓN" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        
                        <ItemsControl x:Name="IcIndustrialMinerals">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding Value, StringFormat={}{0:N1} Tons}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
