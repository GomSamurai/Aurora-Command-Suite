                                    <TextBox x:Name="TxtFormulaLabsCount" Text="10" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
