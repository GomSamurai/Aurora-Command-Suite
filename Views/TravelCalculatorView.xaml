<UserControl x:Class="AuroraDesignSuite.Views.TravelCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1250">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMN 1: DISTANCES, KINEMATICS, TERRAFORMING -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,5,0">
            <StackPanel>
                <!-- Card 1: Astronomical Distance Converter -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🌌 CONVERSOR Y MEDIDOR DE DISTANCIAS ASTRONÓMICAS" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        
                        <!-- Quick Presets Toolbar -->
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="🌙 Tierra-Luna" Click="BtnPresetMoon_Click" Padding="6,3" Margin="0,0,4,4" Background="{DynamicResource CardBgBrush}" Foreground="White" FontSize="10" ToolTip="Preset: 384,400 km (Distancia media Tierra a la Luna)."/>
                            <Button Content="☀️ Tierra-Sol (1 AU)" Click="BtnPresetSun_Click" Padding="6,3" Margin="0,0,4,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentGreenBrush}" FontSize="10" ToolTip="Preset: 1.0 UA / 149,597,870 km (Unidad Astronómica estándar)."/>
                            <Button Content="🪐 Sol-Neptuno" Click="BtnPresetNeptune_Click" Padding="6,3" Margin="0,0,4,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontSize="10" ToolTip="Preset: 30.1 UA / 4.5 Billones km (Frontera del sistema solar)."/>
                            <Button Content="⭐ Proxima Centauri" Click="BtnPresetProxima_Click" Padding="6,3" Margin="0,0,0,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentAmberBrush}" FontSize="10" ToolTip="Preset: 4.24 Años Luz (Sistema estelar más cercano)."/>
                        </WrapPanel>

                        <TextBlock Text="Distancia en Kilómetros (km):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtDistanceKm" Text="149597870" TextChanged="TxtDistanceKm_TextChanged" Padding="6" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" ToolTip="Ingresa cualquier distancia en kilómetros para convertirla automáticamente a todas las unidades astrofísicas."/>

                        <UniformGrid Columns="2">
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Unidades Astronómicas (1 AU = 149,597,870 km).">
                                <StackPanel>
                                    <TextBlock Text="Unidades Astronómicas (AU):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblValAU" Text="1.00 AU" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Tiempo en segundos que tarda un pulso de luz en viajar esta distancia.">
                                <StackPanel>
                                    <TextBlock Text="Segundos-Luz:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblValLightSec" Text="499.0 Seg" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Días que tarda un haz de luz en recorrer el trayecto.">
                                <StackPanel>
                                    <TextBlock Text="Días-Luz (Light-Days):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblValLightDays" Text="0.01 Días" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Años-Luz (1 LY = 9.46 Trillones de km).">
                                <StackPanel>
                                    <TextBlock Text="Años-Luz (Light-Years):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblValLightYears" Text="0.000016 AL" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Space Transit Kinematics -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🚀 CALCULADOR DE TIEMPO Y CINEMÁTICA DE VIAJE ESPACIAL" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Distancia de Transito (AU):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtTransitDistAU" Text="10.0" TextChanged="OnKinematicsInputChanged" Padding="6" Background="{DynamicResource BgDarkBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="12" ToolTip="Distancia del viaje en Unidades Astronómicas (AU)."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Velocidad Nave (km/s):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtTransitSpeedKmS" Text="4500" TextChanged="OnKinematicsInputChanged" Padding="6" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="12" ToolTip="Velocidad sostenida de la nave o escuadra en km/s."/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3">
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Duración estimada del tránsito en horas.">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Horas de Viaje:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LblTransitHours" Text="92.4 Horas" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Duración estimada del tránsito en días continuos.">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Días de Viaje:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LblTransitDays" Text="3.85 Días" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Fracción de la velocidad de la luz (% c).">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Velocidad Relativa:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LblTransitPercentC" Text="1.50% c" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Planetary Terraforming Calculator -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="🌱 CALCULADOR AVANZADO DE TERRAFORMACIÓN Y HÁBITAT" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Presión Actual (atm):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtCurAtmos" Text="0.20" TextChanged="OnTerraformInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="11" ToolTip="Presión atmosférica actual del planeta en atm."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                <TextBlock Text="Presión Objetivo (atm):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtTgtAtmos" Text="1.00" TextChanged="OnTerraformInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="11" ToolTip="Presión atmosférica deseada para hábitat respirable."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="Módulos Instalados:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtTerraformersCount" Text="10" TextChanged="OnTerraformInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="11" ToolTip="Cantidad de instalaciones o módulos de terraformación instalados en el planeta."/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="2">
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Tasa anual de inyección/extracción atmosférica combinada.">
                                <StackPanel>
                                    <TextBlock Text="Capacidad Anual de Cambio:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblTerraformRate" Text="0.10 atm / Año" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Tiempo estimado para alcanzar la atmósfera objetivo y reducir el Colony Cost a 0.0.">
                                <StackPanel>
                                    <TextBlock Text="Tiempo Estimado Total:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblTerraformYears" Text="8.00 Años (96 Meses)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- COLUMN 2: ORDNANCE PENETRATION, SENSOR RANGE, CARGO LOGISTICS -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="5,0,0,0">
            <StackPanel>
                <!-- Card 4: Armor Penetration & Crater Profile -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💥 CALCULADOR DE PENETRACIÓN DE BLINDAJE Y CRÁTER (ORDNANCE)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Cabeza de Guerra / Daño (Pts):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtDamagePts" Text="16" TextChanged="OnArmorInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="12" ToolTip="Puntos de daño de la cabeza de guerra del misil o impacto de arma de energía."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Capas de Blindaje Enemigo:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtArmorLayersCount" Text="3" TextChanged="OnArmorInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="12" ToolTip="Grosor en capas del blindaje del buque objetivo."/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Profundidad del cráter de impacto calculada por la regla de raíz cuadrada de Aurora 4X.">
                                <StackPanel>
                                    <TextBlock Text="Profundidad del Cráter:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblCraterDepth" Text="4 Capas de Profundidad" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Ancho en la superficie del perfil de impacto en forma de V.">
                                <StackPanel>
                                    <TextBlock Text="Ancho de Superficie:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblCraterWidth" Text="4 Bloques de Ancho" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" ToolTip="Evaluación de penetración y riesgo de daño crítico a los componentes internos.">
                            <TextBlock x:Name="LblArmorPenStatus" Text="💥 BRECHA DE BLINDAJE: Daño directo a componentes internos" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 5: Sensor Coverage & Detection Range -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📡 CALCULADOR DE ALCANCE DE SENSORES ACTIVOS Y PASIVOS" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                <TextBlock Text="Tamaño Sensor (HS):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtSensorHS" Text="10" TextChanged="OnSensorInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="11" ToolTip="Tamaño en Hull Size (HS) del sensor activo o pasivo."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                <TextBlock Text="Resolución (Res):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtSensorRes" Text="20" TextChanged="OnSensorInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="11" ToolTip="Resolución del sensor (Res 1 para misiles, Res 20 para cazas/fragatas, Res 100 para buques capitales)."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="2,0,0,0">
                                <TextBlock Text="Firma Enemigo (TH):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtTargetTH" Text="500" TextChanged="OnSensorInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="11" ToolTip="Firma térmica (TH) o firma de radar RCS del blanco objetivo."/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="2">
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Alcance máximo de detección en millones de kilómetros.">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Alcance en Kilómetros:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LblSensorRangeKm" Text="50,000,000 km" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Alcance máximo de detección expresado en Unidades Astronómicas (AU).">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Alcance en AU:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LblSensorRangeAU" Text="0.33 AU" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Card 6: Cargo & Colonization Logistics Calculator -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="📦 CALCULADOR DE LOGÍSTICA DE CARGA, COLONIZACIÓN Y CONVOYES" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Carga Total a Mover (Tons):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtTotalCargoTons" Text="50000" TextChanged="OnCargoInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="11" ToolTip="Toneladas totales de instalaciones (fábricas, minas) o volumen de colonos a transportar."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Capacidad por Nave (Tons):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtShipCapTons" Text="10000" TextChanged="OnCargoInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Bold" FontSize="11" ToolTip="Capacidad de carga útil de 1 carguero o nave de colonización."/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="2">
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Número de viajes de ida y vuelta necesarios con 1 nave para trasladar toda la carga.">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Viajes Necesarios (1 Nave):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LblCargoVoyages" Text="5 Viajes" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2" ToolTip="Tiempo total estimado para completar la operación logística.">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Tiempo Total Operación:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LblCargoTotalDays" Text="19.3 Días" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
