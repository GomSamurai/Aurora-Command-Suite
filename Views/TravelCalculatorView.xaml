                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                    <TextBlock Text="Población Colonia (M):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
