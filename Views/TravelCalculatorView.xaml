                    <!-- Formula 16: Mass Driver Transport & Collision Safety -->
                    <Border x:Name="CardCalc16" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
