<Window x:Class="AuroraDesignSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AuroraDesignSuite.Views"
        mc:Ignorable="d"
        Title="Aurora 4X - Design &amp; Empire Command Center Master Suite (12 Módulos en Vivo)" 
        Height="880" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid Background="{DynamicResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Top Header Bar with Global Empire Selector & Live Bridge Status -->
        <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀 AURORA MASTER COMMAND SUITE" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                        <TextBlock Text="v2.7.1 LIVE BRIDGE (12 MÓDULOS)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="10.5"/>
                    </Border>
                </StackPanel>

                <!-- Global Empire Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="👑 IMPERIO ACTIVO:" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbGlobalEmpire" SelectionChanged="CmbGlobalEmpire_SelectionChanged" Width="260" VerticalAlignment="Center" ToolTip="Selecciona el Imperio de tu partida actual cuyos datos deseas conectar en toda la suite."/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="STATUS: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="● CONECTADO" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>

                    <TextBlock Text="🎨 ESTILO VISUAL:" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <ComboBox x:Name="CmbThemeSelector" SelectionChanged="CmbThemeSelector_SelectionChanged" Width="220" VerticalAlignment="Center" ToolTip="Cambia drásticamente la paleta de colores y el esquema visual de toda la aplicación en tiempo real.">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentAmberBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource CardHeaderBrush}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,4,4,4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <Button Content="🎮 VOLVER A AURORA 4X" Click="BtnFocusGame_Click" Padding="10,4" Margin="14,0,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" ToolTip="Enfoca al instante la ventana del juego Aurora 4X en primer plano."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Vertical Sidebar Navigation Dock & Main Content Area -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" TabStripPlacement="Left" SelectionChanged="MainTabControl_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="6">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Margin" Value="0,1.5"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="BdrTab" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="10,7" Margin="0,1.5" Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="BdrTab" Property="Background" Value="{DynamicResource CardHeaderBrush}"/>
                                        <Setter TargetName="BdrTab" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BdrTab" Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Sidebar Navigation Dock Container -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Left Sidebar Header Banner -->
                                <Border Grid.Row="0" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock Text="🗺️ MENÚ DE COMANDO" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="12 MÓDULOS" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="9.5"/>
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <!-- Scrollable Vertical Tab Panel -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TabPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- GridSplitter for Resizing Navigation Dock -->
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True" ToolTip="Arrastra horizontalmente para redimensionar el menú de navegación izquierdo"/>

                        <!-- Main Display View -->
                        <Border Grid.Column="2" Background="Transparent" Margin="2,0,0,0">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- DIVISION 1: GOBIERNO Y COLONIAS -->
            <TabItem x:Name="TabEmpire" Header="🏰 MI IMPERIO">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:EmpireOverviewView x:Name="ViewEmpire"/>
            </TabItem>

            <TabItem x:Name="TabColonies" Header="🪐 COLONIAS Y MINERALES">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:ColoniesOverviewView x:Name="ViewColonies"/>
            </TabItem>

            <TabItem x:Name="TabCommanders" Header="🎖️ ALTO MANDO">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentRedBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:CommandersHQView x:Name="ViewCommanders"/>
            </TabItem>

            <!-- DIVISION 2: CIENCIA E INDUSTRIA -->
            <TabItem x:Name="TabResearch" Header="🔬 INVESTIGACIÓN I+D">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentPurpleBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:ResearchHQView x:Name="ViewResearch"/>
            </TabItem>

            <TabItem x:Name="TabIndustrial" Header="⚡ INDUSTRIA Y FÁBRICAS">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:IndustrialHQView x:Name="ViewIndustrial"/>
            </TabItem>

            <!-- DIVISION 3: INGENIERÍA Y DISEÑO -->
            <TabItem x:Name="TabBlueprint" Header="🛠️ DISEÑADOR NAVES">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:BlueprintDesignerView x:Name="ViewBlueprint"/>
            </TabItem>

            <TabItem x:Name="TabMissile" Header="🚀 LAB MISILES/MOTORES">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentRedBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:MissileEngineLabView x:Name="ViewMissile"/>
            </TabItem>

            <TabItem x:Name="TabShipyards" Header="🏭 OPERACIONES ASTILLERO">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:ShipyardOperationsView x:Name="ViewShipyards"/>
            </TabItem>

            <!-- DIVISION 4: OPERACIONES NAVALES -->
            <TabItem x:Name="TabActiveFleets" Header="🛸 MIS FLOTAS Y NAVES">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:ActiveFleetsView x:Name="ViewActiveFleets"/>
            </TabItem>

            <TabItem x:Name="TabFleet" Header="⚓ AUDITORÍA NAVAL">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:FleetCompositionView x:Name="ViewFleet"/>
            </TabItem>

            <TabItem x:Name="TabExploration" Header="🌌 EXPLORACIÓN Y SISTEMAS">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:SystemExplorationView x:Name="ViewExploration"/>
            </TabItem>

            <!-- DIVISION 5: IA E INTELIGENCIA -->
            <TabItem x:Name="TabAI" Header="🧠 INTELIGENCIA ESTRATÉGICA">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:AIAssistantView x:Name="ViewAI"/>
            </TabItem>

            <!-- Module 12: Spatial Audit & Utilities -->
            <TabItem x:Name="TabCalculators" Header="📐 AUDITORÍA Y HERRAMIENTAS">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentPurpleBrush}" FontWeight="Bold" FontSize="12" Margin="2,0"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:TravelCalculatorView x:Name="ViewCalculators"/>
            </TabItem>
        </TabControl>

        <!-- Row 2: Footer Bar -->
        <Border Grid.Row="2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <TextBlock Text="Aurora 4X Design &amp; Empire Command Center Master Suite | Aurora 4X v2.7.1 | C# WPF Live Bridge (12 Módulos)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                <TextBlock Text="👑 Creado por Fran Gómez &amp; Antigravity AI | © 2026 Aurora Master Suite" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
