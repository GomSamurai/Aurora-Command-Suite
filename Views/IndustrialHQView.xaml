<UserControl x:Class="AuroraDesignSuite.Views.IndustrialHQView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="500"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="380" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- Column Splitter for Resizing Main Workplace vs Right Sidebar -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True" ToolTip="Arrastra horizontalmente para redimensionar la barra lateral de telemetría industrial">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource BorderBrush}" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Left Column: Resizable Installations, Projects, Toolbar, Mineral Bar & Building Guide -->
        <Grid Grid.Column="0" Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="130"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*" MinHeight="130"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Card: Installations DataGrid -->
            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,4" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🏗️ INSTALACIONES INDUSTRIALES Y FÁBRICAS ACTIVAS EN TU IMPERIO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgInstallations" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Instalación Industrial" Binding="{Binding InstallationName}" Width="200"/>
                            <DataGridTextColumn Header="Cantidad Actual" Binding="{Binding AmountDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Objetivo Recomendado" Binding="{Binding RecommendedDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Evaluación &amp; Estado" Binding="{Binding StatusBadge}" Width="130"/>
                            <DataGridTextColumn Header="Recomendación Táctica" Binding="{Binding RecommendationHint}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Row Splitter for Vertical Resizing -->
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" ShowsPreview="True" ToolTip="Arrastra verticalmente hacia arriba o abajo para redimensionar las secciones">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{DynamicResource BorderBrush}" Height="2" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Middle Card: Projects DataGrid -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,6" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="⚡ PROYECTOS Y ÓRDENES INDUSTRIALES EN CURSO (CON FECHA ESTIMADA DE FINALIZACIÓN)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgIndustrialProjects" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proyecto / Construcción" Binding="{Binding Description}" Width="220"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding AmountDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Progreso BP" Binding="{Binding ProgressDisplay}" Width="160"/>
                            <DataGridTextColumn Header="Fecha de Finalización" Binding="{Binding CompletionDateDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusDisplay}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Row 3: Action Toolbar -->
            <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙️ ACCIONES INDUSTRIALES DIRECTAS EN BASE DE DATOS:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="❌ Cancelar Proyecto" Click="BtnCancelProject_Click" Padding="10,6" Margin="0,0,8,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentRedBrush}" BorderBrush="{DynamicResource AccentRedBrush}" FontWeight="Bold"/>
                        <Button Content="🚀 Asignar Nueva Orden de Construcción" Click="BtnNewIndustrialOrder_Click" Padding="12,6" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 4: Mineral Demand Pill Bar -->
            <Border Grid.Row="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="💎 DEMANDA ESTIMADA DE MINERALES EN PROYECTOS:" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl Grid.Column="1" x:Name="IcIndustrialMinerals">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Value, StringFormat={}{0:N1} t}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Row 5: Building Encyclopedia Guide (Moved to Bottom Left Area in 3 Horizontal Columns!) -->
            <Border Grid.Row="5" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="📖 GUÍA DE INSTALACIONES Y EDIFICIOS IMPERIALES" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 1 -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="🏭 Fábrica Construcción (120 BP): Produce instalaciones y convierte industria convencional." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock Text="⛏️ Mina Convencional (120 BP): Extrae minerales en planetas requiriendo población." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock Text="🤖 Mina Automatizada (240 BP): Extrae minerales sin población (asteroides/cometas)." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock Text="⛽ Refinería Sorium (120 BP): Convierte el Sorium mineral en combustible espacial." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                        </StackPanel>

                        <!-- Column 2 -->
                        <StackPanel Grid.Column="1" Margin="4,0,8,0">
                            <TextBlock Text="💣 Fábrica Armamento (120 BP): Fabrica misiles, torpedos y munición táctica." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock Text="🛩️ Fábrica de Cazas (120 BP): Construye cazas y naves parásitas de &lt; 500t." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock Text="🏛️ Centro Financiero (120 BP): Genera riqueza y créditos imperiales continuos." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock Text="🌐 Catapulta de Masa (120 BP): Lanza minerales extraídos hacia otras colonias." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                        </StackPanel>

                        <!-- Column 3 -->
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="🌍 Estación Terraformación (300 BP): Modifica atmósferas para costo colonial 0.00." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock Text="📡 Rastreador DSTS (300 BP): Sensores de espacio profundo a millones de km." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock Text="🚀 Puerto Espacial (600 BP): Acelera la carga/descarga de mercancías y minería." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right Column: Industrial Telemetry, Strategic Advisor & Calculator -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="2,0,0,0">
            <StackPanel>
                <!-- Card 1: Imperial Industrial Telemetry -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📊 TELEMETRÍA INDUSTRIAL IMPERIAL" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Población Imperial Total:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblTotalPopulation" Text="0.0 Millones" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Capacidad Producción BP/Año:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblTotalBPOutput" Text="0 BP / Año" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Fábricas de Construcción Activas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblConstructionFactories" Text="0 Fábricas" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Fábricas de Misiles y Cazas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblOrdnanceFactories" Text="0 Fábricas" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Refinerías de Sorium Activas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblFuelRefineries" Text="0 Refinerías" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Capacidad Minera Imperial:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblMiningCapacity" Text="0 Minas" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <TextBlock Text="Bonificación de Gobernador:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblGovBonus" Text="+0.0%" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Imperial Strategic Recommendation Advisor -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💡 ASESOR DE PLANIFICACIÓN IMPERIAL" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock Text="Evaluación estratégica basada en la población y desarrollo actual de tu civilización:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="🏗️ Conversión de Industria Convencional" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock x:Name="LblAdviceConversion" Text="Sincronizando instalaciones con AuroraDB..." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                            <StackPanel>
                                <TextBlock Text="⛽ Almacenamiento y Logística de Combustible" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock x:Name="LblAdviceRefinery" Text="Sincronizando refinerías de Sorium..." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 3: Industrial Build Time & Throughput Calculator -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="🧮 CALCULADORA DE TIEMPOS DE FABRICACIÓN" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Costo de Construcción Objetivo (BP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtTargetBP" Text="120.0" TextChanged="OnCalcInputChanged" Margin="0,0,0,8" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Fábricas de Construcción Asignadas:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtAssignedFactories" Text="100" TextChanged="OnCalcInputChanged" Margin="0,0,0,10" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Rendimiento Anual:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock x:Name="LblCalcAnnualBP" Text="1,000 BP/Año" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Tiempo Estimado Construcción:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock x:Name="LblCalcDays" Text="44 Días (1.4 Meses)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
