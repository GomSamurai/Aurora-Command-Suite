                            </Grid>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="10,6">
                                <TextBlock x:Name="LblFormulaMassDriverResult" Text="Calculando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Formula 17: Research RP Output & Scientist Director -->
                    <Border x:Name="CardCalc17" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🎓 17. Puntos de Investigación I+D &amp; Tiempos (Research Output &amp; Scientist Bonus)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula los Puntos de Investigación (RP/año y RP/mes) generados por tus laboratorios aplicando el bono del científico asignado y calcula el tiempo exacto para desbloquear la tecnología." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
