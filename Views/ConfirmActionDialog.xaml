<Window x:Class="AuroraDesignSuite.Views.ConfirmActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmación de Acción Imperial" Height="320" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource CardBgBrush}">
    <Border BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1.5" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="TxtTitle" Text="🛡️ CONFIRMACIÓN DE DECRETO DE ASTILLERO" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="14"/>
                <Separator Background="{DynamicResource BorderBrush}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Content Details -->
            <Border Grid.Row="1" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDescription" Text="¿Estás seguro de que deseas autorizar la ampliación de capacidad del astillero?" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Margin="0,2">
                        <TextBlock Text="Costo Estimado:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="TxtCost" Text="120 BP / 500 Tons Duranium" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Duración Estimada:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="TxtDuration" Text="3 Meses (90 Días)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="❌ Cancelar" Click="BtnCancel_Click" Width="110" Height="32" Margin="0,0,10,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentRedBrush}" BorderBrush="{DynamicResource AccentRedBrush}" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="✅ Confirmar y Ejecutar" Click="BtnConfirm_Click" Width="160" Height="32" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
