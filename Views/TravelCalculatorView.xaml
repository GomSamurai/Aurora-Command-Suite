                                <TextBlock x:Name="LblFormulaResearchResult" Text="Calculando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Formula 18: Point Defense Interception vs Salvo -->
                    <Border x:Name="CardCalc18" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="💣 18. Defensa Antimisil &amp; Intercepción CIWS (Point Defense Interception Rate)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula el % de precisión del control de tiro antimisil según la velocidad de los misiles enemigos entrantes y muestra cuántos misiles serán interceptados por turno de 5s." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
