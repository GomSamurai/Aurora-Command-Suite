                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                    <TextBlock Text="Centros Financieros:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaFinancialCount" Text="50" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="Gastos Militares Anuales:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaMilitaryExpenses" Text="500000" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="10,6">
                                <TextBlock x:Name="LblFormulaWealthResult" Text="Calculando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

