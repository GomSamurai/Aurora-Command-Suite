<UserControl x:Class="AuroraDesignSuite.Views.UtilityCalculatorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- GridSplitter for Resizing Utility Calculators Panels -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True" ToolTip="Arrastra horizontalmente para redimensionar las herramientas y calculadoras espaciales">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource BorderBrush}" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Left Panel: Distance Converter & Travel Time Calculator -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
            <StackPanel>
                <!-- Astronomical Unit Converter -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🌌 CONVERSOR DE DISTANCIAS ASTRONÓMICAS" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Text="Distancia en Kilómetros (km):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtDistKm" Text="149597870" TextChanged="OnDistanceKmChanged" Margin="0,0,0,10" ToolTip="Introduce cualquier distancia en kilómetros para convertirla a UA, Días-Luz y Años-Luz."/>

                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Unidades Astronómicas (UA):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblValAu" Text="1,00 AU" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Días-Luz (Light-Days):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblValLightDays" Text="0,01 Días-Luz" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Años-Luz (Light-Years):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblValLightYears" Text="0,000015 AL" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Travel Time Calculator -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="⏱️ CALCULADOR DE TIEMPO DE VIAJE ESPACIAL" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Distancia (Billones km):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox x:Name="TxtTravelDistBillion" Text="1,5" TextChanged="OnTravelInputChanged" ToolTip="Distancia a navegar en Billones de Kilómetros."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Velocidad Nave (km/s):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox x:Name="TxtTravelSpeedKmS" Text="4500" TextChanged="OnTravelInputChanged" ToolTip="Velocidad máxima sostenida de tu flota en km/s."/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Duración del Viaje (Horas):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblTravelHours" Text="92,6 Horas" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Duración del Viaje (Días):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblTravelDays" Text="3,86 Días" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Duración del Viaje (Meses):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblTravelMonths" Text="0,13 Meses" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Panel: Terraforming & Strategic Logistics Audit -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="4,0,0,0">
            <StackPanel>
                <!-- Terraforming Calculator -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🌱 CALCULADOR DE TERRAFORMACIÓN PLANETARIA" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Text="Presión Atmosférica Actual (atm):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtCurrentPress" Text="0,20" TextChanged="OnTerraformInputChanged" Margin="0,0,0,8" ToolTip="Presión atmosférica actual del planeta o luna."/>

                        <TextBlock Text="Presión Atmosférica Objetivo (atm):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtTargetPress" Text="1,00" TextChanged="OnTerraformInputChanged" Margin="0,0,0,8" ToolTip="Presión atmosférica objetivo respirable (ej. 1.0 atm como la Tierra)."/>

                        <TextBlock Text="Módulos Terraformadores Instalados:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtTerraformModules" Text="10" TextChanged="OnTerraformInputChanged" Margin="0,0,0,10" ToolTip="Número de instalaciones o naves terraformadoras asignadas a la colonia."/>

                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Diferencia de Presión a Cambiar:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblPressDiff" Text="0,80 atm" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Capacidad Anual de Cambio:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblTerraformRate" Text="0,50 atm/año" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Tiempo Estimado de Terraformación:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LblTerraformYears" Text="1,60 Años" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Strategic Imperial Logistics & Fuel Burn Rate Audit -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="📊 AUDITORÍA LOGÍSTICA DE RECURSOS Y SORIUM" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,3" ToolTip="Relación directa entre toneladas de Sorium refinadas y litros de combustible producidos.">
                                    <TextBlock Text="Tasa de Conversión Sorium:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="1.0 t = 2,500 L" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3" ToolTip="Capacidad de almacenamiento en la capital imperial.">
                                    <TextBlock Text="Tanques Principales Capital:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="100,000,000 L" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,3" ToolTip="Autonomía estratégica del imperio ante bloqueo o interrupción de minería.">
                                    <TextBlock Text="Reserva Estratégica Mínima:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="12.5 Meses" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
