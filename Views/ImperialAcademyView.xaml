<UserControl x:Class="AuroraDesignSuite.Views.ImperialAcademyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="280"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Column Splitter -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource BorderBrush}" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Left Panel: Category Filter, Search Bar & Articles List -->
        <Grid Grid.Column="0" Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Header Banner -->
            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="🎓 ACADEMIA IMPERIAL 4X" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="LblTotalCount" Text="(0 Artículos)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Enciclopedia Imperial, Lecciones Interactivas, Fórmulas y Códex Táctico." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Interactive Search Bar -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="🔍 BUSCADOR EN TIEMPO REAL" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtSearchCodex" TextChanged="TxtSearchCodex_TextChanged" Padding="8,5" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="12" ToolTip="Escribe cualquier término, tecnología, mineral, fórmula o sigla (ej. Duranium, TCS, Sorium, Laser, Missile, Refuelling...)"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Category Filter Combo -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="🏷️ FILTRAR POR CATEGORÍA" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboCategoryFilter" SelectionChanged="CboCategoryFilter_SelectionChanged" Padding="6,4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                        <ComboBoxItem Content="🌟 Todas las Categorías" IsSelected="True"/>
                        <ComboBoxItem Content="🎓 Tutoriales &amp; Lecciones"/>
                        <ComboBoxItem Content="📊 Economía, Industria &amp; Colonias"/>
                        <ComboBoxItem Content="🚀 Naves, Cascos &amp; Componentes"/>
                        <ComboBoxItem Content="🔬 Tecnologías e Investigaciones"/>
                        <ComboBoxItem Content="⚓ Flotas, Combate &amp; Misiles"/>
                        <ComboBoxItem Content="⛏️ Minerales &amp; Recursos"/>
                        <ComboBoxItem Content="🎖️ Comandantes &amp; Oficiales"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Card 4: Articles List -->
            <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📚 ARTÍCULOS ENCONTRADOS" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" FontSize="10.5" Margin="0,0,0,8"/>
                    <ListBox x:Name="LstCodexItems" SelectionChanged="LstCodexItems_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding DisplayTitle}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Right Panel: Detailed Reader -->
        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="4,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PnlArticleContent">
                    <TextBlock x:Name="LblArticleTitle" Text="Bienvenido a la Academia Imperial Aurora 4X" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="20" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,16" HorizontalAlignment="Left">
                        <TextBlock x:Name="LblArticleCategory" Text="🎓 Módulo de Tutoría y Enciclopedia Imperial" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    
                    <TextBox x:Name="TxtArticleBody" Text="Selecciona cualquier término de la izquierda o busca en tiempo real arriba para desplegar la ficha explicativa completa." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Margin="0,0,0,16"/>

                    <!-- INTERACTIVE PHYSICS & GAME MATH FORMULA SANDBOX SUITE -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <!-- Header Control Bar: Toggle On/Off & Selector Button -->
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="🧮 SUITE DIDÁCTICA Y CALCULADORAS AURORA 4X" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Button to Toggle Entire Calculators Panel Visibility -->
                                    <Button x:Name="BtnToggleCalculators" Click="BtnToggleCalculators_Click" Content="👁️ Ocultar Calculadoras" Padding="8,4" Margin="0,0,8,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                    <!-- Button to Open Selector Drawer / Popup -->
                                    <Button x:Name="BtnSelectCalculators" Click="BtnSelectCalculators_Click" Content="🎛️ Selector de Calculadoras (10/10) 🔻" Padding="8,4" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- POPUP / DRAWER SELECTOR PANEL -->
                            <Border x:Name="PnlCalculatorSelector" Visibility="Collapsed" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="⚙️ SELECCIONA QUÉ HERRAMIENTAS DE CÁLCULO MANTENER VISIBLES:" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Click="BtnCheckAll_Click" Content="✅ Seleccionar Todas" Padding="6,2" Margin="0,0,6,0" Background="Transparent" Foreground="{DynamicResource AccentGreenBrush}" BorderThickness="0" FontSize="10.5" Cursor="Hand"/>
                                            <Button Click="BtnUncheckAll_Click" Content="❌ Desmarcar Todas" Padding="6,2" Margin="0,0,6,0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontSize="10.5" Cursor="Hand"/>
                                            <Button Click="BtnResetDefault_Click" Content="🔄 Predeterminado" Padding="6,2" Background="Transparent" Foreground="{DynamicResource AccentCyanBrush}" BorderThickness="0" FontSize="10.5" Cursor="Hand"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- 10 Modular CheckBoxes in 2 Columns -->
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkCalc1" Content="💥 1. Penetración de Blindaje &amp; Ojiva" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                        <CheckBox x:Name="ChkCalc2" Content="📡 2. Alcance Máximo Radar Activo" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                        <CheckBox x:Name="ChkCalc3" Content="⛽ 3. Consumo Combustible &amp; Impulso" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                        <CheckBox x:Name="ChkCalc4" Content="🏗️ 4. Tiempo &amp; Costo Retooling Astilleros" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                        <CheckBox x:Name="ChkCalc5" Content="🚀 5. Velocidad Máxima Naval (EP/HS)" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                        <CheckBox x:Name="ChkCalc6" Content="🌌 6. Autonomía &amp; Consumo (AU/Bkm)" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                        <CheckBox x:Name="ChkCalc7" Content="🔧 7. Tasa de Fallos (AFR) &amp; Pañol MSP" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                        <CheckBox x:Name="ChkCalc8" Content="🌍 8. Costo Colonial Planetario" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                        <CheckBox x:Name="ChkCalc9" Content="⛏️ 9. Producción Minera &amp; Rendimiento" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                        <CheckBox x:Name="ChkCalc10" Content="🛰️ 10. Detección Pasiva Térmica &amp; Sigilo" IsChecked="True" Checked="OnCalcVisibilityChanged" Unchecked="OnCalcVisibilityChanged" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,3"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- MAIN CALCULATORS CONTAINER -->
                            <StackPanel x:Name="PnlCalculatorsContainer">
                                <TextBlock Text="Prueba en vivo los cálculos reales de balística, física, astilleros, logística y biomasa empleados por el motor del juego:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,0,0,12"/>

                                <!-- Formula 1: Missile Penetration -->
                                <Border x:Name="CardCalc1" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="💥 1. Penetración de Blindaje y Daño de Ojiva (Missile Penetration)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Potencia de Cabeza de Guerra (Yield Points):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaWarheadYield" Text="16" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Penetración Físicamente Calculada: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaWarheadResult" Text="4 Capas de Blindaje (Crater: 4 x 4)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 2: Active Radar Range -->
                                <Border x:Name="CardCalc2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="📡 2. Alcance Máximo de Radar Activo (Active Sensor Range)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Fuerza del Radar (Active Sensor Strength):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaRadarStrength" Text="24" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Resolución del Radar (Res 1 = Cazas, Res 100 = Cruceros):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaRadarRes" Text="100" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Alcance Máximo vs Objetivo Objetivado: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaRadarResult" Text="96.00 Mkm (96,000,000 km)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 3: Engine Burn & Fuel -->
                                <Border x:Name="CardCalc3" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="⛽ 3. Consumo de Combustible e Impulso (Engine Burn &amp; Fuel)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Empuje Total de Motor (EP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaEngineEP" Text="500" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Consumo (Litros / EP / Hora):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaEngineFuelRate" Text="0.8" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Consumo de Combustible por Día: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaEngineResult" Text="9,600 Litros / Día de navegación continua" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 4: Retooling Cost & Duration -->
                                <Border x:Name="CardCalc4" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🏗️ 4. Tiempo y Costo de Retooling de Astilleros (Shipyard Retooling)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Capacidad Máxima del Astillero (Tons):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaRetoolCapacity" Text="10000" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Diferencia de Diseño (0% = Variante, 100% = Nueva Clase):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaRetoolDiff" Text="20" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Costo &amp; Tiempo Estimado de Retooling: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaRetoolResult" Text="180 BP (131 Días de re-equipamiento)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 5: Naval Max Speed -->
                                <Border x:Name="CardCalc5" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🚀 5. Velocidad Máxima Naval (Naval Speed Engine vs Tonnage)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Potencia Total de Motores (EP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaSpeedEP" Text="1200" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Tamaño Total de la Nave (HS - 1 HS = 50 tons):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaSpeedHS" Text="300" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Velocidad Máxima Calculada: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaSpeedResult" Text="4,000 km/s (14,400,000 km/h)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 6: Max Range & Endurance -->
                                <Border x:Name="CardCalc6" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🌌 6. Autonomía Máxima y Consumo LPH (Flight Endurance &amp; Range)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Capacidad de Tanques de Combustible (Litros):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaRangeFuel" Text="500000" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Velocidad Cruce (km/s):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaRangeSpeed" Text="4000" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Autonomía en Navegación: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaRangeResult" Text="72.00 Mil Millones km (481.28 AU) | 52.1 Días de vuelo continuo" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 7: Maintenance AFR & MSP -->
                                <Border x:Name="CardCalc7" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🔧 7. Tasa Anual de Fallos (AFR) y Repuestos de Mantenimiento (MSP)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Costo de Construcción de la Nave (BP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaMaintBP" Text="1500" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Puntuación de Control de Daños (DCR / Pañoles):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaMaintDCR" Text="12" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Riesgo Mecánico Estimado: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaMaintResult" Text="AFR: 25.0% | Tiempo Promedio entre Fallos: 1,460 Días" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 8: Planet Colony Cost -->
                                <Border x:Name="CardCalc8" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🌍 8. Costo Colonial y Habitable Planetario (Colony Cost)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Temperatura Superficial (°C):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaColonyTemp" Text="-45" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Presión de Oxígeno O2 (atm - Ideal: 0.15):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaColonyO2" Text="0.02" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Clasificación Colonial: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaColonyResult" Text="Colony Cost: 2.25 (Requiere 225 Infraestructuras por M de habs)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 9: Mining & Production Yield -->
                                <Border x:Name="CardCalc9" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="⛏️ 9. Rendimiento de Producción Minera e Industrial (Mining Rate)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Número de Minas Activas (Minas TN / Automatizadas):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaMiningCount" Text="50" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Accesibilidad del Yacimiento (0.1 a 1.0):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaMiningAcc" Text="0.8" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Rendimiento Anual de Extracción: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaMiningResult" Text="480 Tons / Año por mineral (Total: 5,280 Tons combinadas)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 10: Thermal Signature & Stealth Detection -->
                                <Border x:Name="CardCalc10" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="🛰️ 10. Detección Pasiva Térmica y Sigilo (Thermal Signature &amp; Stealth)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Radiación Térmica de Motor (TH / EP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaStealthTH" Text="800" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Fuerza del Sensor Térmico Pasivo Enemigo (Sens Sensitivity):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaStealthSens" Text="30" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Distancia Máxima de Detección Térmica: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaStealthResult" Text="240.00 Mkm (Distancia de delación pasiva)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
