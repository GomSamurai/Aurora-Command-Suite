                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="Tonelaje Flota Actual (Tons):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtFormulaActiveTonnage" Text="35000" TextChanged="OnFormulaInputChanged" Padding="5" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="10,6">
                                <TextBlock x:Name="LblFormulaNavalMaintResult" Text="Calculando..." Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Formula 20: Empire Wealth Generation & Expenses -->
                    <Border x:Name="CardCalc20" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
