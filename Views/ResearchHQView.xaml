<UserControl x:Class="AuroraDesignSuite.Views.ResearchHQView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1400">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="350"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="440" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- GridSplitter for Resizing Tech Tree Panel and Laboratory Management Panel -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True" ToolTip="Arrastra horizontalmente para redimensionar el árbol tecnológico y la gestión de laboratorios">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource BorderBrush}" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Left Column: Fluid Responsive Layout (Fills 100% Screen Height) -->
        <Grid Grid.Column="0" Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="180"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="1.5*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Active Research Projects & Integrated Global Telemetry (Row 0) -->
            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <!-- Header Bar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="🔬 PROYECTOS DE INVESTIGACIÓN ACTIVOS EN VIVO (CON FECHA ESTIMADA DE COMPLETADO)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="LblActiveLabsCount" Text="17 Labs en Uso" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="-5 Labs" Click="BtnRemove5Labs_Click" Padding="6,2" Margin="0,0,3,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" FontSize="10" FontWeight="Bold"/>
                            <Button Content="-1 Lab" Click="BtnRemove1Lab_Click" Padding="6,2" Margin="0,0,3,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" FontSize="10" FontWeight="Bold"/>
                            <Button Content="+1 Lab" Click="BtnAdd1Lab_Click" Padding="6,2" Margin="0,0,3,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold"/>
                            <Button Content="+5 Labs" Click="BtnAdd5Labs_Click" Padding="6,2" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Integrated Global Telemetry Footer (Fixed Docked to Bottom of Card 1) -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                        <Grid x:Name="PnlGlobalTelemetry">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="📊 TELEMETRÍA GLOBAL:" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <UniformGrid Grid.Column="1" Columns="4">
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Total Labs: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                                        <TextBlock x:Name="LblGlobalTotalLabs" Text="17 Labs" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Ocupación: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                                        <TextBlock x:Name="LblGlobalLabsInUse" Text="17/0 (100%)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="10.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="RP Bruta/Año: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                                        <TextBlock x:Name="LblGlobalTotalRpYear" Text="3,400 RP" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="10.5"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Bono Promedio: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                                        <TextBlock x:Name="LblGlobalAvgBonus" Text="+23.5%" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="10.5"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Active Projects DataGrid (Fills Remaining Space inside Card 1) -->
                    <DataGrid x:Name="DgResearchProjects" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgResearchProjects_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tecnología en Desarrollo" Binding="{Binding TechName}" Width="190"/>
                            <DataGridTextColumn Header="Labs" Binding="{Binding FacilitiesCount}" Width="50"/>
                            <DataGridTextColumn Header="Progreso RP" Binding="{Binding ProgressDisplay}" Width="140"/>
                            <DataGridTextColumn Header="Fecha Finalización" Binding="{Binding CompletionDateDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Científico Líder" Binding="{Binding AssignedScientistName}" Width="140"/>
                            <DataGridTextColumn Header="Especialidad" Binding="{Binding ScientistFieldDisplay}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Vertical GridSplitter directly between Active Projects and Tech Tree (Row 1) -->
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" ShowsPreview="True" ToolTip="Arrastra verticalmente para redimensionar los proyectos activos y el catálogo de tecnologías">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{DynamicResource BorderBrush}" Height="2" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Card 2: Tech Tree Catalog with Search Filter (Row 2 - Fills Remaining Screen Height!) -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="🌳 ÁRBOLES Y TECNOLOGÍAS INVESTIGABLES (FCT_TechData)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="🔍 Buscar:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtSearchTech" TextChanged="TxtSearchTech_TextChanged" Width="170" Padding="4" Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="11" Margin="0,0,10,0" ToolTip="Filtra tecnologías en tiempo real por cualquier palabra clave (ej. 'railgun', 'shield', 'terra')."/>

                            <TextBlock Text="Categoría:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="CmbTechCategory" SelectionChanged="CmbTechCategory_SelectionChanged" Width="180" ToolTip="Filtra el árbol tecnológico por rama científica de especialización."/>
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrid fills 100% remaining vertical space -->
                    <DataGrid x:Name="DgTechTree" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgTechTree_SelectionChanged" VerticalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre Tecnología" Binding="{Binding TechName}" Width="*"/>
                            <DataGridTextColumn Header="Categoría Científica" Binding="{Binding CategoryName}" Width="190"/>
                            <DataGridTextColumn Header="Costo en RP" Binding="{Binding DevelopCost, StringFormat={}{0:N0} RP}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Right Column: Project Assignment & Intelligent Dossiers Sidebar -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Card 1: Project Assignment Panel -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel x:Name="PnlAssignment">
                        <TextBlock Text="🚀 CONFIGURE Y ASIGNE PROYECTOS DE I+D" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                        <TextBlock Text="Tecnología Seleccionada:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbSelectTech" SelectionChanged="CmbSelectTech_SelectionChanged" Margin="0,0,0,8" ToolTip="Selecciona directamente la tecnología que deseas investigar de la lista desplegable. Deja el ratón sobre cualquier opción para desplegar su guía táctica completa.">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="ToolTip" Value="{Binding FullTooltipDisplay}"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Laboratorios de I+D a Asignar:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="LblValLabs" Text="5 Labs" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Slider x:Name="SldLabs" Minimum="1" Maximum="20" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnAssignmentParamChanged" Margin="0,0,0,8" ToolTip="Cantidad de instalaciones de laboratorios dedicadas exclusivamente a este proyecto."/>

                        <TextBlock Text="Asignar Científico Líder:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbScientists" SelectionChanged="CmbScientists_SelectionChanged" Margin="0,0,0,8" ToolTip="Asigna a un científico del imperio. Si su especialidad coincide con la rama de la tecnología, aportará un bono científico completo."/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🚀 Iniciar Proyecto" Click="BtnAssignResearch_Click" Padding="6,6" Margin="0,0,3,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" ToolTip="Registra e inicia este proyecto de investigación en AuroraDB.db."/>
                            <Button Grid.Column="1" Content="❌ Cancelar Proyecto" Click="BtnCancelResearch_Click" Padding="6,6" Margin="3,0,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentRedBrush}" BorderBrush="{DynamicResource AccentRedBrush}" FontWeight="Bold" FontSize="11" ToolTip="Cancela el proyecto de investigación activo seleccionado en AuroraDB.db."/>
                        </Grid>

                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                            <TextBlock Text="💡 Al hacer clic en 'Iniciar Proyecto', los laboratorios y el científico se conectarán en vivo a la cola de I+D de Aurora 4X." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 2: Tactical Tech Information Dossier -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel x:Name="PnlTacticalTechDossier">
                        <TextBlock Text="📖 DOSSIER Y UTILIDAD TÁCTICA DE LA TECNOLOGÍA" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="🔬" FontFamily="Segoe UI Emoji, Segoe UI" Foreground="{DynamicResource AccentCyanBrush}" FontSize="22" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LblTacticalTechName" Text="Tecnología Seleccionada" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="LblTacticalCategory" Text="Categoría: General" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                            <TextBlock x:Name="TxtTacticalDescription" Text="Selecciona una tecnología para consultar su descripción amplia, utilidad militar/industrial y ventajas estratégicas." Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Margin="0,2">
                            <TextBlock Text="Costo en Puntos de Investigación (RP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                            <TextBlock x:Name="LblTacticalCost" Text="0 RP" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Scientist Attributes Dossier -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel x:Name="PnlScientistDossier">
                        <TextBlock Text="📂 DOSSIER OFICIAL DEL CIENTÍFICO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="👨‍🔬" FontFamily="Segoe UI Emoji, Segoe UI" Foreground="{DynamicResource AccentAmberBrush}" FontSize="24" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LblDossierScientistName" Text="Científico Seleccionado" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="LblDossierRating" Text="Antigüedad: 79 Rating | Puesto: Investigador Principal" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,2">
                            <TextBlock Text="Especialidad Técnica:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                            <TextBlock x:Name="LblDossierField" Text="⚡ Potencia y Propulsión" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Bonificación de Investigación:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                            <TextBlock x:Name="LblDossierBonus" Text="+25,0%" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Máximo Laboratorios Simultáneos:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5"/>
                            <TextBlock x:Name="LblDossierMaxLabs" Text="10 Labs (Admin Rating)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>

                        <Border x:Name="BrdDossierMatchStatus" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,6,0,0">
                            <TextBlock x:Name="LblDossierMatchStatus" Text="⚡ COINCIDENCIA PERFECTA (+25% BONUS APLICADO)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 4: RP Progress & Time Simulator -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="🧮 SIMULADOR DE TIEMPO Y PROGRESO CIENTÍFICO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="Estimación de tiempo combinando labs y bonos de científico:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,6"/>

                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="Velocidad I+D (RP/Año):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblSimRpYear" Text="1,250 RP/Año" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="Multiplicador Científico:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                    <TextBlock x:Name="LblSimBonus" Text="+25% (Emparejado)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Tiempo Estimado de Finalización:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock x:Name="LblSimEstimatedTime" Text="1 Año y 4 Meses (486 Días)" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 5: Research Advisor Card -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock Text="💡 RECOMENDACIÓN IMPERIAL DE I+D" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LblResearchHint" Text="Emparejar la especialidad técnica del científico con la categoría del proyecto aumenta el ritmo de investigación hasta en un +35%." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
