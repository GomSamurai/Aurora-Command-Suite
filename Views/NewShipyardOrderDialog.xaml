<Window x:Class="AuroraDesignSuite.Views.NewShipyardOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🚀 Nueva Orden de Construcción Naval" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🚀 ORDENAR CONSTRUCCIÓN DE UNIDAD NAVAL" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="15"/>
            <TextBlock x:Name="LblTargetShipyard" Text="Astillero Destino: Nava Dock (5,000 t)" Foreground="{DynamicResource AccentAmberBrush}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Form Inputs -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="Seleccionar Clase de Nave del Imperio:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                <ComboBox x:Name="CmbShipClasses" SelectionChanged="CmbShipClasses_SelectionChanged" Margin="0,0,0,10" ToolTip="Clases de naves disponibles e investigadas en tu imperio."/>

                <TextBlock Text="Nombre de la Unidad / Casco:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtUnitName" Text="S.M.S. Numancia-01" Margin="0,0,0,10" ToolTip="Nombre único con el que se bautizará esta nave al salir de las gradas."/>

                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Masa Requerida:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="LblTonnageReq" Text="5,000 Tons" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Costo de Construcción:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock x:Name="LblCostReq" Text="250 BP" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="BdrCapacityWarning" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Visibility="Collapsed" Margin="0,6,0,0">
                    <TextBlock Text="⚠️ Atención: La masa de esta nave supera la capacidad máxima actual del astillero." Foreground="{DynamicResource AccentAmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="✕ Cancelar" Click="BtnCancel_Click" Padding="12,6" Margin="0,0,8,0" Background="#222" Foreground="White" BorderBrush="{DynamicResource BorderBrush}"/>
            <Button Content="🚀 Enviar Orden al Astillero" Click="BtnConfirm_Click" Padding="14,6" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
