                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Bonificación del Gobernador / Tecnología (% extra):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaGovMod" Text="25" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Rendimiento Industrial Anual: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaConstResult" Text="1,250 BP / Año (Tiempo para edificar 1 fábrica de 120 BP: ~35 Días)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 15: EM Passive Sensor Detection -->
                                <Border x:Name="CardCalc15" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🛰️ 15. Detección Pasiva Electromagnética (EM Sensor Range)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                                            <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula la distancia en Mkm a la que tus sensores pasivos EM detectan la radiación de escudos, reactores y radares enemigos sin necesidad de encender tu propio radar activo y delatarte." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        </Border>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Emisión Electromagnética Enemiga (EM Output):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaEMSensingSig" Text="500" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Sensibilidad de tu Sensor EM Pasivo:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaEMSensRating" Text="40" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Alcance de Detección Pasiva EM: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaEMResult" Text="200.00 Mkm (Detección de emisiones de escudos/radares)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 16: Mass Driver Logistics -->
                                <Border x:Name="CardCalc16" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🚀 16. Logística de Catapulta de Masa (Mass Driver Transport Rate)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                                            <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula las toneladas de mineral transferidas anualmente desde un asteroide minero hacia tu colonia principal mediante catapultas de masa (Mass Drivers) sin requerir cargueros." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        </Border>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Número de Catapultas de Masa en el Asteroide:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaMassDriverCount" Text="3" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Distancia al Planeta Destino (Millones de km):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaDriverDist" Text="150" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Capacidad Logística Anual: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaMassDriverResult" Text="15,000 Tons / Año catapultadas (Tránsito: ~3.5 Días por paquete)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 17: Research RP Output -->
                                <Border x:Name="CardCalc17" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🎓 17. Puntos de Investigación I+D (Research Points RP/Year)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                                            <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula los Puntos de Investigación (RP/año) generados por tus laboratorios aplicando el porcentaje de bonificación del científico asignado. Optimiza el tiempo para desbloquear tecnologías clave." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        </Border>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Número de Laboratorios de I+D Asignados:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaLabsCount" Text="10" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Bonificación del Científico (% de su especialidad):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaSciBonus" Text="30" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Generación de I+D Calculada: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaResearchResult" Text="2,600 RP / Año (Tiempo para investigar tech de 5,000 RP: ~1.9 Años)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 18: Point Defense & CIWS -->
                                <Border x:Name="CardCalc18" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="💣 18. Defensa Antimisil de Área y CIWS (Point Defense Density)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                                            <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula cuántos misiles enemigos entrantes pueden ser destruidos por turno por tus torretas Gauss y sistemas CIWS. Asegura la supervivencia de tus buques insignia frente a salvas masivas." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        </Border>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Número de Disparos de Cañones Gauss por Turno:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaGaussCount" Text="12" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Velocidad de Seguimiento del Control de Tiro (km/s):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaTrackingSpeed" Text="16000" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Efectividad de Intercepción Antimisil: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaPointDefResult" Text="~6.0 Misiles enemigos interceptados por turno de 5 segundos" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 19: Naval Maintenance Capacity -->
                                <Border x:Name="CardCalc19" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="⚓ 19. Capacidad de Mantenimiento Naval (Naval Maintenance Capacity)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                                            <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula el tonelaje máximo de naves de guerra que tus instalaciones de mantenimiento naval pueden mantener estacionadas en órbita sin que sufran degradación ni averías mecánicas." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        </Border>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Número de Instalaciones de Mantenimiento Naval:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaMaintFacCount" Text="20" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Población de la Colonia (Millones de habitantes):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaColonyPop" Text="500" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Capacidad Máxima de Dique Seco: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaNavalMaintResult" Text="40,000 Toneladas Navales soportadas sin desgaste" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Formula 20: Empire Wealth Generation -->
                                <Border x:Name="CardCalc20" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="💵 20. Generación de Riqueza Imperial (Empire Wealth Income)" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                                            <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Calcula la Riqueza total generada al año por impuestos a la población civil y centros financieros. Mantiene las arcas imperiales en positivo para financiar salarios de oficiales e investigación." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        </Border>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Población Civil Total (Millones de habitantes):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaPopMillions" Text="1000" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Número de Centros Financieros Operativos:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtFormulaFinancialCount" Text="50" TextChanged="OnFormulaInputChanged" Grid.Column="1" Padding="4" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="3" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Ingresos Financieros Imperiales: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock x:Name="LblFormulaWealthResult" Text="2,250,000 Riqueza / Año (Población: 1M + Centros Financieros: 1.25M)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
