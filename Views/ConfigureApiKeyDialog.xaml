<Window x:Class="AuroraDesignSuite.Views.ConfigureApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 Configuración de Gemini API Key Imperial"
        Height="360" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}"
        WindowStyle="SingleBorderWindow">
    <Border Padding="20" Background="{DynamicResource BgDarkBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="🤖 INTELIGENCIA TÁCTICA: CONFIGURACIÓN GEMINI API" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="14"/>
                    <Border Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                        <TextBlock Text="GOOGLE AI STUDIO" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="10"/>
                    </Border>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Information Prompt -->
            <TextBlock Grid.Row="1" Text="Para activar la Inteligencia Táctica Imperial conectada con Google Gemini API, introduce tu clave personal (API Key). Cada usuario debe configurar su propia clave gratuita." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,14"/>

            <!-- Key Input Section -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Clave de API Gemini (API Key):" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtApiKey" Padding="8,6" Background="{DynamicResource BgDarkBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" FontSize="12" ToolTip="Pega tu clave Gemini API Key (comienza habitualmente por AIzaSy...)"/>
                        <Button Grid.Column="1" x:Name="BtnGetFreeKey" Content="🌐 Obtener Clave Gratis" Click="BtnGetFreeKey_Click" Padding="10,6" Margin="8,0,0,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" ToolTip="Abre aistudio.google.com en tu navegador para generar una clave Gemini API de forma 100% gratuita."/>
                    </Grid>

                    <TextBlock Text="🔒 Tu clave se guardará localmente en tu equipo (config/gemini_api.config) y NUNCA se compartirá ni subirá a repositorios." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Guardar y Conectar API" Click="BtnSave_Click" Padding="16,6" Margin="0,0,8,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="12"/>
                <Button Content="❌ Cancelar / Usar Modo Local" Click="BtnCancel_Click" Padding="14,6" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
