<UserControl x:Class="AuroraDesignSuite.Views.CommandersHQView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1250">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="350"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="400" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- GridSplitter for Resizing Roster and Dossier Panels -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True" ToolTip="Arrastra horizontalmente para redimensionar el listado de oficiales y el dossier">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource BorderBrush}" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Column 0: Commander Roster & Search Engine (Main Workstation) -->
        <Grid Grid.Column="0" Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Filter & Search Bar -->
            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="🎖️ CUARTEL GENERAL Y ESTADO MAYOR DE LÍDERES IMPERIALES" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Búsqueda Rápida por Nombre:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtSearchCommander" TextChanged="TxtSearchCommander_TextChanged" ToolTip="Escribe el nombre o apellido del comandante para filtrar el listado al instante."/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="Filtrar por Rol / Especialidad:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbRoleFilter" SelectionChanged="CmbRoleFilter_SelectionChanged" ToolTip="Filtra por tipo de líder (Científicos, Oficiales Navales, Gobernadores o Comandantes Terrestres)."/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Disponibilidad:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbStatusFilter" SelectionChanged="CmbStatusFilter_SelectionChanged" ToolTip="Filtra por estado de servicio (Asignados a misiones vs Disponibles)."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Roster DataGrid -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                <DataGrid x:Name="DgCommanders" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgCommanders_SelectionChanged" ToolTip="Líderes de tu imperio. Haz clic en cualquiera para inspeccionar su expediente oficial (Dossier) a la derecha.">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Estado" Binding="{Binding StatusDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Nombre del Comandante" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Rol / Especialidad" Binding="{Binding TypeDisplay}" Width="160"/>
                        <DataGridTextColumn Header="Rango / Título" Binding="{Binding Title}" Width="160"/>
                        <DataGridTextColumn Header="Antigüedad" Binding="{Binding Seniority, StringFormat={}{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="Bonificación Principal" Binding="{Binding PrimaryBonusDisplay}" Width="210"/>
                        <DataGridTextColumn Header="Destino Actual" Binding="{Binding AssignmentLocation}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Action Bar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="⚡ Recomendador Inteligente de Mando" Click="BtnAutoAssign_Click" Padding="12,6" Margin="0,0,6,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Escanea en vivo los 179 oficiales de tu imperio en AuroraDB.db y recomienda automáticamente las asignaciones óptimas."/>
                <Button Content="📜 Asignar Destino / Misión" Click="BtnAssignTask_Click" Padding="12,6" Margin="0,0,6,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" ToolTip="Registra la asignación oficial del comandante a un laboratorio, nave o colonia."/>
                <Button Content="🎖️ Conceder Promoción de Rango" Click="BtnPromote_Click" Padding="12,6" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentAmberBrush}" BorderBrush="{DynamicResource AccentAmberBrush}" FontWeight="Bold" ToolTip="Incrementa el rango oficial y la aptitud de mando del oficial seleccionado."/>
            </StackPanel>
        </Grid>

        <!-- Column 2: Dossier, Bonuses & Leadership Impact Dashboard -->
        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="📁 DOSSIER OFICIAL DEL COMANDANTE" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                    <!-- Dossier Card -->
                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel x:Name="PnlDossier">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtDossierIcon" Text="🎓" FontSize="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="LblDossierName" Text="Dr. Aarón Cordero Burgos" Foreground="White" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LblDossierTitle" Text="Director de I+D Imperial" Foreground="{DynamicResource AccentCyanBrush}" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,2">
                                <TextBlock Text="Destino / Puesto Actual:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblDossierLocation" Text="Lab. I+D N° 1 (Tierra)" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Antigüedad en Servicio:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblDossierSeniority" Text="38 Rating" Foreground="White" HorizontalAlignment="Right" FontSize="11"/>
                            </Grid>
                            
                            <Grid Margin="0,4,0,2">
                                <TextBlock Text="Aptitud de Promoción:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblDossierPromotion" Text="75 / 100" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                            </Grid>
                            <ProgressBar x:Name="PbPromotion" Value="75" Maximum="100" Height="6" Foreground="{DynamicResource AccentAmberBrush}" Background="#111" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,4"/>

                            <Grid Margin="0,4,0,2">
                                <TextBlock Text="Lealtad Política Imperial:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="LblDossierLoyalty" Text="100 %" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="11"/>
                            </Grid>
                            <ProgressBar x:Name="PbLoyalty" Value="100" Maximum="100" Height="6" Foreground="{DynamicResource AccentGreenBrush}" Background="#111" BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Real Bonuses Breakdown Matrix -->
                    <TextBlock Text="📊 MATRIZ DE BONIFICACIONES Y ESPECIALIDADES" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8" ToolTip="Bonificaciones numéricas activas aplicadas a los laboratorios, naves o colonias gobernadas.">
                        <ItemsControl x:Name="IcDetailedBonuses">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ValueDisplay}" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Interactive Leadership Impact Calculator -->
                    <TextBlock Text="🧮 CALCULADORA DE IMPACTO IMPERIAL" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="LblImpactInputLabel" Text="Rendimiento Base (I+D / Minería / Flota):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox x:Name="TxtImpactBase" Text="1000" TextChanged="OnImpactInputChanged" Margin="0,2,0,6" ToolTip="Ingresa el valor base de producción o I+D para calcular la aportación extra del líder."/>

                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Aportación Extra del Líder:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock x:Name="LblImpactExtra" Text="+250.0 Unidades/año" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Rendimiento Total con Liderazgo:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock x:Name="LblImpactTotal" Text="1,250.0 Unidades/año" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Imperial Staff Telemetry Summary -->
                    <TextBlock Text="🎖️ TELEMETRÍA GENERAL DEL ESTADO MAYOR" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <TextBlock Text="Total Comandantes Activos:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblStaffTotal" Text="0" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Científicos e Investigadores:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblStaffScientists" Text="0" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Oficiales Navales:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblStaffNaval" Text="0" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Gobernadores Planetarios:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblStaffGovernors" Text="0" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Promedio de Antigüedad:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblStaffAvgSeniority" Text="0.0 Rating" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
