                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <TextBlock Text="📖 ¿PARA QUÉ SIRVE Y CÓMO USAR ESTA HERRAMIENTA?&#10;Mide el tonelaje militar máximo soportado por tus instalaciones navales en órbita y alerta si la flota actual supera la capacidad provocando desgaste y averías mecánicas." Foreground="{DynamicResource AccentAmberBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
