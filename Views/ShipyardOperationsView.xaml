<UserControl x:Class="AuroraDesignSuite.Views.ShipyardOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1250">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="350"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="380" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- GridSplitter for Resizing Left and Right Panels -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="True" ToolTip="Arrastra horizontalmente para redimensionar el panel de astilleros y el de telemetría">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{DynamicResource BorderBrush}" Width="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Column 0: Shipyard Operations & Active Tasks (Main Workstation) -->
        <Grid Grid.Column="0" Margin="0,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="280"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Card: Shipyards DataGrid -->
            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="🏭 COMPLEJOS DE ASTILLEROS NAVALES Y COMERCIALES" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <Button Content="➕ Ampliar Grada / Capacidad" Click="BtnExpandShipyard_Click" HorizontalAlignment="Right" Padding="8,3" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Registra una expansión industrial de tonelaje o gradas de construcción."/>
                    </Grid>

                    <DataGrid x:Name="DgShipyards" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgShipyards_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre del Astillero" Binding="{Binding ShipyardName}" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TypeDisplay}" Width="160"/>
                            <DataGridTextColumn Header="Gradas" Binding="{Binding Slipways}" Width="70"/>
                            <DataGridTextColumn Header="Capacidad Máxima" Binding="{Binding CapacityTons, StringFormat={}{0:N0} t}" Width="140"/>
                            <DataGridTextColumn Header="Estado de Gradas" Binding="{Binding StatusDisplay}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Bottom Card: Active Construction Tasks & Action Toolbar -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="LblTasksHeader" Grid.Row="0" Text="🔨 TAREAS DE CONSTRUCCIÓN NAVAL Y RETOOLING ACTIVAS" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1" x:Name="DgShipyardTasks" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Acción / Diseñador" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📐 Diseñador" Click="BtnSendTaskToDesigner_Click" Padding="6,2" Margin="2,1" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="10.5" ToolTip="Carga la clase que se está fabricando en esta grada directamente en el Diseñador de Naves."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Unidad / Clase en Construcción" Binding="{Binding UnitName}" Width="*"/>
                            <DataGridTextColumn Header="Progreso BP" Binding="{Binding ProgressDisplay}" Width="200"/>
                            <DataGridTemplateColumn Header="Avance" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="14" Foreground="{DynamicResource AccentCyanBrush}" Background="#111" BorderBrush="{DynamicResource BorderBrush}"/>
                                            <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F1}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action Bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="❌ Cancelar Tarea" Click="BtnCancelTask_Click" Padding="10,6" Margin="0,0,6,0" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentRedBrush}" BorderBrush="{DynamicResource AccentRedBrush}" ToolTip="Cancela la tarea seleccionada en la grada de construcción y libera el espacio."/>
                        <Button Content="🔧 Re-equipar (Retooling)" Click="BtnRetoolShipyard_Click" Padding="10,6" Margin="0,0,6,0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource AccentCyanBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" ToolTip="Re-equipa este astillero para fabricar una nueva clase de nave."/>
                        <Button Content="🚀 Ordenar Nueva Nave" Click="BtnNewOrder_Click" Padding="12,6" Background="{DynamicResource CardHeaderBrush}" Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" FontWeight="Bold" ToolTip="Añade una nueva orden de construcción directamente a las gradas de este astillero."/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Column 2: Telemetry, Calculator & Mineral Dashboard -->
        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="📊 TELEMETRÍA GLOBAL DE ASTILLEROS" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                    <!-- Empire Summary Panel -->
                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,2" ToolTip="Capacidad combinada de astilleros navales militares.">
                                <TextBlock Text="Capacidad Naval Milit.:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblTotalNavalCap" Text="0 t" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2" ToolTip="Capacidad combinada de astilleros comerciales.">
                                <TextBlock Text="Capacidad Comercial:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblTotalCommCap" Text="0 t" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2" ToolTip="Número de gradas activas construyendo vs gradas libres disponibles.">
                                <TextBlock Text="Gradas Libres / Totales:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblSlipwaysStatus" Text="0 / 0" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2" ToolTip="Puntos de Construcción (BP) anuales generados por la industria de astilleros del imperio.">
                                <TextBlock Text="Rendimiento Anual BP:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblAnnualBPOutput" Text="0 BP/año" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2" ToolTip="Bonificación de velocidad asignada por el Gobernador Planetario de la capital.">
                                <TextBlock Text="Bono Gobernador:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblGovBonus" Text="+10.0 %" Foreground="{DynamicResource AccentCyanBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Interactive Build Time & Retooling Calculator -->
                    <TextBlock Text="🧮 CALCULADORA DE TIEMPOS Y RETOOLING" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Masa de Nave (Tons):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox x:Name="TxtCalcTonnage" Text="5000" TextChanged="OnCalcInputChanged" Margin="0,0,0,6" ToolTip="Ingresa el tonelaje de la nave para calcular requisitos de astillero y tiempo."/>

                            <TextBlock Text="Costo de Nave (BP):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox x:Name="TxtCalcCostBP" Text="250" TextChanged="OnCalcInputChanged" Margin="0,0,0,6" ToolTip="Ingresa el costo en Puntos de Construcción (BP) de la nave."/>

                            <TextBlock Text="Rendimiento Grada (BP/año):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox x:Name="TxtCalcBPRate" Text="500" TextChanged="OnCalcInputChanged" Margin="0,0,0,6" ToolTip="Puntos de construcción por año generados por el astillero."/>

                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6" Margin="0,4,0,0">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Tiempo Estimado Construcción:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock x:Name="LblCalcBuildDays" Text="183 Días (6.1 m)" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Costo Re-equipamiento (Retool):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock x:Name="LblCalcRetoolBP" Text="62.5 BP" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Tiempo Estimado Retooling:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock x:Name="LblCalcRetoolDays" Text="45 Días" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Exotic Mineral Requirements Breakdown -->
                    <TextBlock Text="💎 MINERALES REQUERIDOS EN GRADAS" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" ToolTip="Minerales trans-uranio requeridos para completar todas las naves en construcción en este astillero.">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <TextBlock Text="Duranium (Estructuras):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblMinDuranium" Text="0.0 t" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Neutronium (Blindajes):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblMinNeutronium" Text="0.0 t" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Gallicite (Propulsión):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblMinGallicite" Text="0.0 t" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Uridium (Sensores / Control):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="LblMinUridium" Text="0.0 t" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
